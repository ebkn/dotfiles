# Shared defaults, included as the last lines of ~/.ssh/config inside `Host *`
# (bin/init/common.sh ensure_ssh_base_include). ssh keeps the first value it
# reads, so a host's own block in ~/.ssh/config always wins over these.

# Multiplexed: many short connections (every push, fetch and git-lfs call opens
# one, ~1.5s of key exchange and auth each), none of them interactive. Reusing
# one authenticated connection brings the later ones to ~0.3s.
#
# Only here, deliberately. Multiplexing ties every session to one TCP
# connection: after a network change a new ssh attaches to the dead master and
# hangs until ServerAlive gives up (15s x 6 = ~90s below). For an interactive
# host such as ebiken that would be a plain `ssh`/`scp` -- or `myssh host cmd`,
# which falls back to plain ssh -- hanging after every Wi-Fi switch, to save one
# handshake per session. myssh's own autossh is unaffected either way: it runs
# with -o ControlPath=none (zsh/ssh.zsh).
Host github.com
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h:%p
  ControlPersist 10m

Host *
  TCPKeepAlive yes
  ServerAliveInterval 15
  ServerAliveCountMax 6
  Compression yes
  StrictHostKeyChecking ask
