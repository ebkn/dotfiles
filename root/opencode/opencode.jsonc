{
  "$schema": "https://opencode.ai/config.json",
  // Keep MCP servers in this file, not in a sibling opencode.json: only
  // opencode.jsonc is linked into ~/.config/opencode (bin/init/links.sh), so
  // anything an installer writes to opencode.json reaches no other machine.
  // The AWS CLI's MCP installer does write there — move the entry here.
  "mcp": {
    // Signs requests with the local AWS credential chain; with no credentials
    // the proxy exits at startup and the server simply shows as failed.
    // Pinned, not @latest (which the installer writes): uvx would otherwise
    // run a release the moment it is on PyPI. The pin covers the proxy alone;
    // --exclude-newer holds its 70-odd dependencies to uploads older than 7
    // days, the window npm's min-release-age and the cooldowns use. Raise the
    // pin by hand to a release at least that old.
    // root/uv.toml sets the same window for every uv command, and this flag
    // overrides it: change both together. Kept anyway, so the hold does not
    // depend on uv.toml being linked: this config travels on its own link.
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "--exclude-newer",
        "7 days",
        "mcp-proxy-for-aws@1.7.0",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ]
    }
  }
}
