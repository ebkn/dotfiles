{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode counterpart of root/.claude/settings.json. Hand-maintained:
  // Claude Code has no OpenCode awareness and OpenCode reads no Claude
  // settings, so keep edits to permissions / model policy in both files
  // together. The comments that explain each rule live in
  // [root/README.md](../../README.md); only what differs here is noted.
  //
  // Structure: Claude's allow/ask/deny object plus defaultMode: auto maps
  // to ONE ordered array. OpenCode matches rules in order and the LAST
  // match wins, and Claude's precedence deny > ask > allow is reproduced
  // by writing allow rules first, then ask, then deny.
  //
  // No matching rule → OpenCode asks (build's base policy). Claude's
  // unmatched Bash fell to the auto-mode classifier instead, so OpenCode
  // prompts where Claude would have judged: allow rules must list
  // everything the agent should run unattended, not the exciting extras.
  //
  // Fields with no OpenCode equivalent (hooks, statusLine, enabledPlugins,
  // autoMode.soft_deny, ...) are listed in the comment block at the bottom.

  "permissions": [
    // ── allow: shell ──────────────────────────────────────────────
    // Read-only inspection commands, translated from Bash(...).
    // OpenCode checks each segment of a compound command separately: an
    // allow for every segment lets the whole command run. rm and curl are
    // deliberately absent here — Claude relies on hooks; see the bottom.
    { "action": "shell", "resource": "actionlint *", "effect": "allow" },
    { "action": "shell", "resource": "ast-grep *", "effect": "allow" },
    { "action": "shell", "resource": "autossh -V", "effect": "allow" },
    { "action": "shell", "resource": "awk *", "effect": "allow" },
    { "action": "shell", "resource": "basename *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "cut *", "effect": "allow" },
    { "action": "shell", "resource": "date *", "effect": "allow" },
    { "action": "shell", "resource": "df*", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "dig *", "effect": "allow" },
    { "action": "shell", "resource": "dirname *", "effect": "allow" },
    { "action": "shell", "resource": "done", "effect": "allow" },
    { "action": "shell", "resource": "du*", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "false*", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "fd *", "effect": "allow" },
    { "action": "shell", "resource": "fd", "effect": "allow" },
    { "action": "shell", "resource": "base64*", "effect": "allow" },
    { "action": "shell", "resource": "for *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "groups*", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "host *", "effect": "allow" },
    { "action": "shell", "resource": "id*", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "ls*", "effect": "allow" },
    { "action": "shell", "resource": "log show*", "effect": "allow" },
    { "action": "shell", "resource": "log stats*", "effect": "allow" },
    { "action": "shell", "resource": "lsof*", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "nslookup *", "effect": "allow" },
    { "action": "shell", "resource": "ping *", "effect": "allow" },
    { "action": "shell", "resource": "printf *", "effect": "allow" },
    { "action": "shell", "resource": "ps*", "effect": "allow" },
    { "action": "shell", "resource": "pwd*", "effect": "allow" },
    { "action": "shell", "resource": "read *", "effect": "allow" },
    { "action": "shell", "resource": "readlink *", "effect": "allow" },
    { "action": "shell", "resource": "realpath *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "sed *", "effect": "allow" },
    { "action": "shell", "resource": "shellcheck *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "ssh -V", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "sw_vers", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "tailscale netcheck *", "effect": "allow" },
    { "action": "shell", "resource": "tailscale ping *", "effect": "allow" },
    { "action": "shell", "resource": "tailscale status *", "effect": "allow" },
    { "action": "shell", "resource": "tee *", "effect": "allow" },
    { "action": "shell", "resource": "terminal-notifier *", "effect": "allow" },
    { "action": "shell", "resource": "test *", "effect": "allow" },
    // Claude's ":*" means a bare prefix too; ` *`-ending rules cover it but
    // not the no-colon spelling, so both forms are kept.
    { "action": "shell", "resource": "tmux list-panes:*", "effect": "allow" },
    { "action": "shell", "resource": "tmux list-panes *", "effect": "allow" },
    { "action": "shell", "resource": "tmux list-sessions:*", "effect": "allow" },
    { "action": "shell", "resource": "tmux list-sessions *", "effect": "allow" },
    { "action": "shell", "resource": "touch *", "effect": "allow" },
    { "action": "shell", "resource": "tr *", "effect": "allow" },
    { "action": "shell", "resource": "traceroute *", "effect": "allow" },
    { "action": "shell", "resource": "true*", "effect": "allow" },
    { "action": "shell", "resource": "tree*", "effect": "allow" },
    { "action": "shell", "resource": "uname*", "effect": "allow" },
    { "action": "shell", "resource": "uptime*", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "wait*", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "whoami*", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/aws logs get-query-results *", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/aws logs start-query *", "effect": "allow" },
    { "action": "shell", "resource": "aws logs get-query-results *", "effect": "allow" },
    { "action": "shell", "resource": "aws logs start-query *", "effect": "allow" },
    { "action": "shell", "resource": "docker buildx imagetools inspect *", "effect": "allow" },
    { "action": "shell", "resource": "docker manifest inspect *", "effect": "allow" },
    { "action": "shell", "resource": "docker build*", "effect": "allow" },
    { "action": "shell", "resource": "corepack enable*", "effect": "allow" },
    { "action": "shell", "resource": "brew cat *", "effect": "allow" },
    { "action": "shell", "resource": "brew deps *", "effect": "allow" },
    { "action": "shell", "resource": "brew info *", "effect": "allow" },
    { "action": "shell", "resource": "brew leaves*", "effect": "allow" },
    { "action": "shell", "resource": "brew list*", "effect": "allow" },
    { "action": "shell", "resource": "brew outdated*", "effect": "allow" },
    { "action": "shell", "resource": "brew search *", "effect": "allow" },
    { "action": "shell", "resource": "go build*", "effect": "allow" },
    { "action": "shell", "resource": "go doc*", "effect": "allow" },
    { "action": "shell", "resource": "go list*", "effect": "allow" },
    { "action": "shell", "resource": "go mod graph*", "effect": "allow" },
    { "action": "shell", "resource": "go mod verify*", "effect": "allow" },
    { "action": "shell", "resource": "go mod why *", "effect": "allow" },
    { "action": "shell", "resource": "go test*", "effect": "allow" },
    { "action": "shell", "resource": "go tool cover*", "effect": "allow" },
    { "action": "shell", "resource": "go version*", "effect": "allow" },
    { "action": "shell", "resource": "go vet*", "effect": "allow" },
    { "action": "shell", "resource": "golangci-lint run*", "effect": "allow" },
    { "action": "shell", "resource": "npm diff *", "effect": "allow" },
    { "action": "shell", "resource": "npm explain *", "effect": "allow" },
    { "action": "shell", "resource": "npm fund*", "effect": "allow" },
    { "action": "shell", "resource": "npm ls *", "effect": "allow" },
    { "action": "shell", "resource": "npm outdated*", "effect": "allow" },
    { "action": "shell", "resource": "npm search *", "effect": "allow" },
    { "action": "shell", "resource": "npm view *", "effect": "allow" },
    { "action": "shell", "resource": "npm ci*", "effect": "allow" },
    { "action": "shell", "resource": "npx tsc*", "effect": "allow" },
    { "action": "shell", "resource": "npx jest*", "effect": "allow" },
    { "action": "shell", "resource": "npx vitest*", "effect": "allow" },
    { "action": "shell", "resource": "npx biome*", "effect": "allow" },
    { "action": "shell", "resource": "npx prettier*", "effect": "allow" },
    { "action": "shell", "resource": "yarn info *", "effect": "allow" },
    { "action": "shell", "resource": "yarn list*", "effect": "allow" },
    { "action": "shell", "resource": "yarn outdated*", "effect": "allow" },
    { "action": "shell", "resource": "yarn why *", "effect": "allow" },
    { "action": "shell", "resource": "yarn install*", "effect": "allow" },
    { "action": "shell", "resource": "yarn type-check*", "effect": "allow" },
    { "action": "shell", "resource": "yarn test*", "effect": "allow" },
    { "action": "shell", "resource": "yarn lint*", "effect": "allow" },
    { "action": "shell", "resource": "yarn check*", "effect": "allow" },
    { "action": "shell", "resource": "yarn build*", "effect": "allow" },
    { "action": "shell", "resource": "yarn biome*", "effect": "allow" },
    { "action": "shell", "resource": "yarn format*", "effect": "allow" },
    { "action": "shell", "resource": "yarn codegen*", "effect": "allow" },
    { "action": "shell", "resource": "volta list *", "effect": "allow" },
    { "action": "shell", "resource": "yq *", "effect": "allow" },
    // git — the -C rules stay away, per README's git section: no rule may
    // name -C. In Claude the hooks carried them: git-dash-c-allow.sh
    // approved `git -C <in-project> <subcommand>` against the matching
    // allow rule for `git <subcommand>`, and git-guard.sh applied every
    // deny and ask rule to a git with an option before its subcommand —
    // `git -C x push --force` under the bare-subcommand rules. OpenCode
    // has neither hook, and shell resources are raw strings, so the same
    // command matches NO rule here and falls through to ask: a prompt
    // where Claude refused outright.
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git branch*", "effect": "allow" },
    { "action": "shell", "resource": "git cat-file *", "effect": "allow" },
    { "action": "shell", "resource": "git cherry-pick *", "effect": "allow" },
    { "action": "shell", "resource": "git commit -m *", "effect": "allow" },
    { "action": "shell", "resource": "git config --get *", "effect": "allow" },
    { "action": "shell", "resource": "git config --get-all *", "effect": "allow" },
    { "action": "shell", "resource": "git config --get-regexp *", "effect": "allow" },
    { "action": "shell", "resource": "git config --list*", "effect": "allow" },
    { "action": "shell", "resource": "git config -l*", "effect": "allow" },
    { "action": "shell", "resource": "git config get *", "effect": "allow" },
    { "action": "shell", "resource": "git config list*", "effect": "allow" },
    { "action": "shell", "resource": "git describe*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git fetch*", "effect": "allow" },
    { "action": "shell", "resource": "git for-each-ref *", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files*", "effect": "allow" },
    { "action": "shell", "resource": "git ls-tree *", "effect": "allow" },
    { "action": "shell", "resource": "git merge main *", "effect": "allow" },
    { "action": "shell", "resource": "git merge origin/main *", "effect": "allow" },
    { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
    { "action": "shell", "resource": "git push", "effect": "allow" },
    { "action": "shell", "resource": "git push -u origin HEAD", "effect": "allow" },
    { "action": "shell", "resource": "git push origin HEAD", "effect": "allow" },
    { "action": "shell", "resource": "git remote show*", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git stash*", "effect": "allow" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git tag", "effect": "allow" },
    { "action": "shell", "resource": "git tag -l *", "effect": "allow" },
    { "action": "shell", "resource": "git tag --list *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-list *", "effect": "allow" },
    { "action": "shell", "resource": "git check-ignore *", "effect": "allow" },
    { "action": "shell", "resource": "git worktree list*", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    { "action": "shell", "resource": "git remote get-url *", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager log*", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager diff*", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager show*", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager branch*", "effect": "allow" },
    // gh
    { "action": "shell", "resource": "gh browse *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue status *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view *", "effect": "allow" },
    { "action": "shell", "resource": "gh label list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr create *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr edit*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr ready*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr status *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh release list *", "effect": "allow" },
    { "action": "shell", "resource": "gh release view *", "effect": "allow" },
    { "action": "shell", "resource": "gh repo list *", "effect": "allow" },
    { "action": "shell", "resource": "gh repo view *", "effect": "allow" },
    { "action": "shell", "resource": "gh run list *", "effect": "allow" },
    { "action": "shell", "resource": "gh run view *", "effect": "allow" },
    { "action": "shell", "resource": "gh search code *", "effect": "allow" },
    { "action": "shell", "resource": "gh search commits *", "effect": "allow" },
    { "action": "shell", "resource": "gh search issues *", "effect": "allow" },
    { "action": "shell", "resource": "gh search prs *", "effect": "allow" },
    { "action": "shell", "resource": "gh search repos *", "effect": "allow" },
    { "action": "shell", "resource": "gh workflow list *", "effect": "allow" },
    { "action": "shell", "resource": "gh workflow view *", "effect": "allow" },

    // ── allow: files, web, MCP, skills ────────────────────────────
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    // LS and Search: OpenCode has no tools with those names; file discovery
    // is glob, content search is grep, both allowed above.
    // An explicit read "*" above silently overrides the base policy's .env
    // asks, so they are restated, with the .env.example exception after.
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    // WebFetch(domain:...) — OpenCode matches the requested URL string, and
    // the URL matcher is prefix-pattern based, NOT domain-aware:
    // "https://github.com*" would also match "https://github.com.evil.com",
    // the same trap root/README.md records for curl. Exact-host patterns
    // instead: bare host, then host plus path. Claude's `domain:` rule is an
    // exact-host match too (subdomains need their own `*.host` rule), so
    // this list carries the same host entries settings.json names — no
    // subdomain behavior was traded away in the translation.
    // http:// and query-string-without-slash forms ask, on purpose.
    { "action": "webfetch", "resource": "https://api.github.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://api.github.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://caniuse.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://caniuse.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://cloud.google.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://cloud.google.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://code.claude.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://code.claude.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://developer.mozilla.org", "effect": "allow" },
    { "action": "webfetch", "resource": "https://developer.mozilla.org/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.aws.amazon.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.aws.amazon.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.claude.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.claude.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.docker.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.docker.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.github.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.github.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.npmjs.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.npmjs.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.python.org", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.python.org/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.rs", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.rs/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://gist.github.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://gist.github.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://github.com", "effect": "allow" },
