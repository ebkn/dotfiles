    { "action": "webfetch", "resource": "https://winget.run", "effect": "allow" },
    { "action": "webfetch", "resource": "https://winget.run/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://www.autohotkey.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://www.autohotkey.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://developers.openai.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://developers.openai.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://biomejs.dev", "effect": "allow" },
    { "action": "webfetch", "resource": "https://biomejs.dev/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://www.npmjs.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://www.npmjs.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://developers.cloudflare.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://developers.cloudflare.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://ai.google.dev", "effect": "allow" },
    { "action": "webfetch", "resource": "https://ai.google.dev/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://developers.google.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://developers.google.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://www.anthropic.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://www.anthropic.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.anthropic.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.anthropic.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://claude.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://claude.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://platform.claude.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://platform.claude.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://support.claude.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://support.claude.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://arxiv.org", "effect": "allow" },
    { "action": "webfetch", "resource": "https://arxiv.org/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://coderabbit.ai", "effect": "allow" },
    { "action": "webfetch", "resource": "https://coderabbit.ai/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.coderabbit.ai", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.coderabbit.ai/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://www.coderabbit.ai", "effect": "allow" },
    { "action": "webfetch", "resource": "https://www.coderabbit.ai/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.sentry.io", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.sentry.io/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://sentry.io", "effect": "allow" },
    { "action": "webfetch", "resource": "https://sentry.io/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://vercel.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://vercel.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://trivy.dev", "effect": "allow" },
    { "action": "webfetch", "resource": "https://trivy.dev/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://yarnpkg.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://yarnpkg.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://developer.hashicorp.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://developer.hashicorp.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://posthog.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://posthog.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://brew.sh", "effect": "allow" },
    { "action": "webfetch", "resource": "https://brew.sh/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://github.blog", "effect": "allow" },
    { "action": "webfetch", "resource": "https://github.blog/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.snowflake.com", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.snowflake.com/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://nextjs.org", "effect": "allow" },
    { "action": "webfetch", "resource": "https://nextjs.org/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://pagespeed.web.dev", "effect": "allow" },
    { "action": "webfetch", "resource": "https://pagespeed.web.dev/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.perplexity.ai", "effect": "allow" },
    { "action": "webfetch", "resource": "https://docs.perplexity.ai/*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    // mcp__plugin_sentry_sentry__* rules. OpenCode MCP permission actions are
    // "<mcp server name>_<tool name>", so the wildcards stand in for the
    // server half; tighten to e.g. "sentry_search_events" once the server is
    // named here.
    { "action": "*_search_events", "resource": "*", "effect": "allow" },
    { "action": "*_search_issues", "resource": "*", "effect": "allow" },
    { "action": "*_search_sentry_tools", "resource": "*", "effect": "allow" },
    { "action": "*_find_projects", "resource": "*", "effect": "allow" },
    // Skill(...) — only the git-workflow skills were granted in Claude;
    // everything else still asks by default.
    { "action": "skill", "resource": "commit", "effect": "allow" },
    { "action": "skill", "resource": "create-pr", "effect": "allow" },
    { "action": "skill", "resource": "update-pr", "effect": "allow" },

    // ── ask ───────────────────────────────────────────────────────
    // Positioned after every allow they outrank: git branch* / git stash*
    // allow broadly, the drop/clear/branch-delete forms ask here.
    { "action": "shell", "resource": "wget *", "effect": "ask" },
    { "action": "shell", "resource": "telnet *", "effect": "ask" },
    { "action": "shell", "resource": "nc *", "effect": "ask" },
    { "action": "shell", "resource": "netcat *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force-with-lease*", "effect": "ask" },
    { "action": "shell", "resource": "git push * --force-with-lease*", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop*", "effect": "ask" },
    { "action": "shell", "resource": "git stash clear*", "effect": "ask" },
    { "action": "shell", "resource": "git switch *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -d *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git branch *-d *", "effect": "ask" },
    { "action": "shell", "resource": "git branch *-D *", "effect": "ask" },

    // ── deny ──────────────────────────────────────────────────────
    // Raw command strings, not parsed paths — the tripwire caveat in
    // root/README.md applies as written: variables, cd beforehand and
    // path spelling games walk past every one of these. rm and curl here
    // have no hook equivalents in OpenCode yet (see bottom comment);
    // rm is deny-literals + an edit-rule mirror, exactly like Claude.
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf --no-preserve-root /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf --no-preserve-root /*", "effect": "deny" },
    { "action": "shell", "resource": "rm /etc*", "effect": "deny" },
    { "action": "shell", "resource": "rm * /etc*", "effect": "deny" },
    { "action": "shell", "resource": "rm /usr*", "effect": "deny" },
    { "action": "shell", "resource": "rm * /usr*", "effect": "deny" },
    { "action": "shell", "resource": "rm /var*", "effect": "deny" },
    { "action": "shell", "resource": "rm * /var*", "effect": "deny" },
    { "action": "shell", "resource": "rm /opt*", "effect": "deny" },
    { "action": "shell", "resource": "rm * /opt*", "effect": "deny" },
    { "action": "shell", "resource": "rm /bin*", "effect": "deny" },
    { "action": "shell", "resource": "rm * /bin*", "effect": "deny" },
    { "action": "shell", "resource": "rm /sbin*", "effect": "deny" },
    { "action": "shell", "resource": "rm * /sbin*", "effect": "deny" },
    { "action": "shell", "resource": "rm /lib*", "effect": "deny" },
    { "action": "shell", "resource": "rm * /lib*", "effect": "deny" },
    { "action": "shell", "resource": "rm /lib64*", "effect": "deny" },
    { "action": "shell", "resource": "rm * /lib64*", "effect": "deny" },
    { "action": "shell", "resource": "rm /boot*", "effect": "deny" },
    { "action": "shell", "resource": "rm * /boot*", "effect": "deny" },
    { "action": "shell", "resource": "rm /proc*", "effect": "deny" },
    { "action": "shell", "resource": "rm * /proc*", "effect": "deny" },
    { "action": "shell", "resource": "rm /sys*", "effect": "deny" },
    { "action": "shell", "resource": "rm * /sys*", "effect": "deny" },
    { "action": "shell", "resource": "rm /dev*", "effect": "deny" },
    { "action": "shell", "resource": "rm * /dev*", "effect": "deny" },
    { "action": "shell", "resource": "rm ~/.ssh/id_*", "effect": "deny" },
    { "action": "shell", "resource": "rm * ~/.ssh/id_*", "effect": "deny" },
    { "action": "shell", "resource": "rm ~/.ssh/*_rsa", "effect": "deny" },
    { "action": "shell", "resource": "rm * ~/.ssh/*_rsa", "effect": "deny" },
    { "action": "shell", "resource": "rm ~/.ssh/*_ecdsa", "effect": "deny" },
    { "action": "shell", "resource": "rm * ~/.ssh/*_ecdsa", "effect": "deny" },
    { "action": "shell", "resource": "rm ~/.ssh/*_ed25519", "effect": "deny" },
    { "action": "shell", "resource": "rm * ~/.ssh/*_ed25519", "effect": "deny" },
    { "action": "shell", "resource": "sudo", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "su", "effect": "deny" },
    { "action": "shell", "resource": "su *", "effect": "deny" },
    { "action": "shell", "resource": "doas", "effect": "deny" },
    { "action": "shell", "resource": "doas *", "effect": "deny" },
    { "action": "shell", "resource": "sudo rm *", "effect": "deny" },
    { "action": "shell", "resource": "sudo dd *", "effect": "deny" },
    { "action": "shell", "resource": "sudo mkfs *", "effect": "deny" },
    { "action": "shell", "resource": "sudo fdisk *", "effect": "deny" },
    { "action": "shell", "resource": "sudo mount *", "effect": "deny" },
    { "action": "shell", "resource": "sudo umount *", "effect": "deny" },
    { "action": "shell", "resource": "dd *", "effect": "deny" },
    { "action": "shell", "resource": "mkfs *", "effect": "deny" },
    { "action": "shell", "resource": "fdisk *", "effect": "deny" },
    { "action": "shell", "resource": "> /dev/*", "effect": "deny" },
    { "action": "shell", "resource": ">> /dev/*", "effect": "deny" },
    { "action": "shell", "resource": "chmod 777 /*", "effect": "deny" },
    { "action": "shell", "resource": "chown root *", "effect": "deny" },
    { "action": "shell", "resource": "sudo chmod 777 *", "effect": "deny" },
    { "action": "shell", "resource": "sudo chown *", "effect": "deny" },
    { "action": "shell", "resource": "sudo -i *", "effect": "deny" },
    { "action": "shell", "resource": "sudo su *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf .git", "effect": "deny" },
    // --force spelled as whole words so --force-with-lease survives; the
    // lease spellings are the ask rules above.
    { "action": "shell", "resource": "git push --force", "effect": "deny" },
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --force", "effect": "deny" },
    { "action": "shell", "resource": "git push * --force *", "effect": "deny" },
    { "action": "shell", "resource": "git push * -f *", "effect": "deny" },
    { "action": "shell", "resource": "git push * -f", "effect": "deny" },
    { "action": "shell", "resource": "git clean -fd *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean -fdx *", "effect": "deny" },
    { "action": "shell", "resource": "git fetch *--upl*", "effect": "deny" },
    { "action": "shell", "resource": "git log *--output*", "effect": "deny" },
    { "action": "shell", "resource": "git diff *--output*", "effect": "deny" },
    { "action": "shell", "resource": "git show *--output*", "effect": "deny" },
    { "action": "shell", "resource": "docker system prune -af", "effect": "deny" },
    { "action": "shell", "resource": "go build -toolexec *", "effect": "deny" },
    { "action": "shell", "resource": "go build -toolexec=*", "effect": "deny" },
    { "action": "shell", "resource": "go build * -toolexec *", "effect": "deny" },
    { "action": "shell", "resource": "go build * -toolexec=*", "effect": "deny" },
    { "action": "shell", "resource": "go test -exec *", "effect": "deny" },
    { "action": "shell", "resource": "go test -exec=*", "effect": "deny" },
    { "action": "shell", "resource": "go test * -exec *", "effect": "deny" },
    { "action": "shell", "resource": "go test * -exec=*", "effect": "deny" },
    { "action": "shell", "resource": "go test -toolexec *", "effect": "deny" },
    { "action": "shell", "resource": "go test -toolexec=*", "effect": "deny" },
    { "action": "shell", "resource": "go test * -toolexec *", "effect": "deny" },
    { "action": "shell", "resource": "go test * -toolexec=*", "effect": "deny" },
    { "action": "shell", "resource": "npm publish *", "effect": "deny" },
    { "action": "shell", "resource": "diskutil *", "effect": "deny" },
    { "action": "shell", "resource": "parted *", "effect": "deny" },
    { "action": "shell", "resource": "sfdisk *", "effect": "deny" },
    { "action": "shell", "resource": "gdisk *", "effect": "deny" },
    { "action": "shell", "resource": "wipefs *", "effect": "deny" },
    { "action": "shell", "resource": "newfs*", "effect": "deny" },
    { "action": "shell", "resource": "shred *", "effect": "deny" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "env *", "effect": "deny" },
    { "action": "shell", "resource": "printenv", "effect": "deny" },
    { "action": "shell", "resource": "printenv *", "effect": "deny" },
    // The Edit deny rules, with the same rm mirror reasoning: shell rules
    // match raw text, edit rules match resolved paths, and each needs the
    // other. System trees ($_*) and ssh keys get both spellings; the passwd,
    // shadow and sudoers files are exact.
    { "action": "edit", "resource": "/etc*", "effect": "deny" },
    { "action": "edit", "resource": "/usr*", "effect": "deny" },
    { "action": "edit", "resource": "/var*", "effect": "deny" },
    { "action": "edit", "resource": "/opt*", "effect": "deny" },
    { "action": "edit", "resource": "/bin*", "effect": "deny" },
    { "action": "edit", "resource": "/sbin*", "effect": "deny" },
    { "action": "edit", "resource": "/lib*", "effect": "deny" },
    { "action": "edit", "resource": "/lib64*", "effect": "deny" },
    { "action": "edit", "resource": "/boot*", "effect": "deny" },
    { "action": "edit", "resource": "/proc*", "effect": "deny" },
    { "action": "edit", "resource": "/sys*", "effect": "deny" },
    { "action": "edit", "resource": "/dev*", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/id_*", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/*_rsa", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/*_ecdsa", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/*_ed25519", "effect": "deny" },
    { "action": "edit", "resource": "/etc/passwd", "effect": "deny" },
    { "action": "edit", "resource": "/etc/shadow", "effect": "deny" },
    { "action": "edit", "resource": "/etc/sudoers", "effect": "deny" },

    // Nothing may follow after the deny rules that matches them: the last
    // match wins, so a later allow would resurrect what these refuse.
  ],

  // Claude's autoCompactEnabled: false. Note the difference in defaults:
  // OpenCode compacts automatically by default, so this line is required.
  // Manual /compact still works.
  "compaction": {
    "auto": false,
  },

  // Claude's autoUpdatesChannel: "stable". OpenCode has no channel concept;
  // notify shows an update before installing it, which is the closest
  // behavior to following a week-behind channel. Global config only.
  "update": "notify",

  // "model": "opus" translates to provider/model (e.g.
  // "anthropic/claude-opus-..."), but unlike Claude, the root default does
  // not hold a variant: Claude's effortLevel is per-agent in OpenCode, set
  // as "#variant" on agents.<id>.model or in agent frontmatter.
  // Pick the exact ID from /models and set it here when wanted.

  // ── settings.json fields with no OpenCode equivalent ────────────
  //
  // env.CLAUDE_CODE_SUBAGENT_MODEL: subagents inherit the session model
  //   unless their agent sets its own. Give each subagent a `model` in its
  //   agent file instead; there is no global default for subagents.
  // attribution: OpenCode writes no Co-Authored-By trailers; nothing to
  //   disable.
  // permissions.defaultMode "auto": OpenCode has no permission modes; the
  //   unmatched rule asks and "Allow always" saves it per project (and a
  //   saved approval never overrides a configured deny).
  // worktree.baseRef: OpenCode's `worktree` config only sets the parent
  //   directory.
  // statusLine, theme, editorMode, voice, prefersReducedMotion,
  //   preferredNotifChannel, tui: terminal preferences belong in
  //   ~/.config/opencode/cli.json, not this file (see
  //   https://opencode.ai/v2/docs/cli/config).
  // enabledPlugins, extraKnownMarketplaces: no plugin-marketplace concept.
  //   MCP servers go under `mcp.servers` here; plugins under `plugins`.
  // fastMode (Opus runs), skipWorkflowUsageWarning, askUserQuestionTimeout,
  //   voice, remoteControlAtStartup, autoMemory*, feedback*: Claude
  //   product behavior, not present in OpenCode.
  // autoMode.soft_deny (pnpm db:*): deliberately not copied — per root/
  //   README.md, policy tied to one repository belongs in that repository's
  //   own settings, never here.
  //
  // ── hooks ─────────────────────────────────────────────────────
  //
  // Claude's hooks block above cannot appear in this file. Its equivalents
  // are an OpenCode plugin (`.opencode/plugins/` local plugin or a package
  // in `plugins`); the mapping, should that plugin be written:
  //
  //   PreToolUse(Bash) curl-guard, rm-guard, git-guard,
  //     git-dash-c-allow, approve-multiline-commands,
  //     strip-redundant-cd      → ctx.permission.hook("evaluate") /
  //                               ctx.shell.hook("create.before")
  //   PreToolUse(Agent) agent-model-guard
  //                             → ctx.tool.hook("execute.before") on the
  //                               subagent tool
  //   PreToolUse(AskUserQuestion), Notification, Stop, SessionStart,
  //   SessionEnd, CwdChanged, SubagentStart, SubagentStop, PostToolBatch,
  //   UserPromptSubmit, PermissionRequest (agent-state.sh,
  //   session-cwd.sh)          → ctx.session.hook("prompt") /
  //                               ctx.event.subscribe(...) in a plugin
  //
  // Until one exists, curl and rm have NO hook in OpenCode: curl is absent
  // from allow (as in Claude, where the hook carries it) and unmatched curl
  // asks; rm keeps only the deny literals above.

  // Keep MCP servers in this file, not in a sibling opencode.json: only
  // opencode.jsonc is linked into ~/.config/opencode (bin/init/links.sh), so
  // anything an installer writes to opencode.json reaches no other machine.
  // The AWS CLI's MCP installer does write there — move the entry here.
  "mcp": {
    // The V2 shape is mcp.servers.<name> (the config schema marks a direct
    // mcp.<name> entry deprecated), so keep one nesting level here or the
    // registry stops reading the entry.
    "servers": {
      // Signs requests with the local AWS credential chain; with no credentials
      // the proxy exits at startup and the server simply shows as failed.
      // Pinned, not @latest (which the installer writes): uvx would otherwise
      // run a release the moment it is on PyPI. The pin covers the proxy alone;
      // --exclude-newer holds its 70-odd dependencies to uploads older than 7
      // days, the window npm's min-release-age and the cooldowns use. Raise the
      // pin by hand to a release at least that old.
      // root/uv.toml sets the same window for every uv command, and this flag
      // overrides it: change both together. Kept anyway, so the hold does not
      // depend on uv.toml being linked: this config travels on its own link.
      "aws-mcp": {
        "type": "local",
        "command": [
          "uvx",
          "--exclude-newer",
          "7 days",
          "mcp-proxy-for-aws@1.7.0",
          "https://aws-mcp.us-east-1.api.aws/mcp",
          "--metadata",
          "INSTALL_SOURCE=aws-cli"
        ]
      }
    }
  }
}
