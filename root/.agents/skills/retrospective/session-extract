#!/bin/bash
# Reduce one Claude Code transcript to a single-line JSON summary.
#
# Pure and idempotent: everything here is decided by this session alone, so the
# result never needs revisiting. Anything that depends on other sessions (rework
# across sessions, distributions, outliers) is the reporter's job -- which is
# what lets a later re-aggregation pick up facts that only became true weeks
# after the session ended, without ever rewriting a summary.
#
# jq streams via `inputs`, so peak memory is one record rather than one file.
# That matters: transcripts here reach 7MB, and the store holds 44MB in a week.
set -euo pipefail

mode=summary
if [ "${1:-}" = "--human-turns" ]; then
  mode=human
  shift
fi

if [ $# -ne 1 ]; then
  echo "usage: session-extract [--human-turns] <transcript.jsonl>" >&2
  exit 2
fi

src="$1"
if [ ! -f "$src" ]; then
  echo "session-extract: no such file: $src" >&2
  exit 2
fi

# Shared by both modes so the two can never disagree about what a human turn is.
#
# A "user" record without toolUseResult is NOT necessarily something the human
# typed. The harness injects, as user records: every invoked skill's full body
# and its caveat (isMeta), the summary after each compaction (isCompactSummary),
# the echo and stdout of slash commands (<command-name>, <local-command-*>) and
# background task notifications. On a 124-"turn" session, fewer than half were
# typed -- the rest was the commit skill's text, pasted in six times. Counting
# them inflates user_turns and buries the actual prompts under boilerplate.
# A bare "/compact" typed by the human is kept: it is a human act and a signal.
#
# shellcheck disable=SC2016  # the $r / $t inside are jq's, not the shell's
jq_defs='
  def prompt_text($r):
    $r.message
    | if type != "object" then "" else
        (.content
         | if type == "string" then .
           elif type == "array" then ([.[] | select(.type == "text") | .text] | join("\n"))
           else "" end)
      end;
  def injected($r; $t):
    ($r.isMeta == true)
    or ($r.isCompactSummary == true)
    or ($t | test("^\\s*<(local-command-caveat|local-command-stdout|command-name|command-message|task-notification)"));
  def is_prompt($r):
    $r.type == "user" and $r.toolUseResult == null
    and (prompt_text($r) as $t | (injected($r; $t) | not));
  def is_interrupt($t): $t | test("^\\[Request interrupted");
'

# --human-turns exists so that reading a transcript needs no general-purpose
# tool granted to the skill: allowed-tools is a grant, not a restriction, and
# `Bash(jq *)` would pre-approve every jq invocation for as long as the skill
# runs. (An earlier version of this comment claimed the grant would also cover
# a redirect such as `jq . x > ~/.zshrc`; the boundary eval showed a redirect
# being denied under a prefix grant, so that claim is withdrawn. The decision
# stands on the narrower ground.) This mode can only read.
if [ "$mode" = human ]; then
  jq -r "${jq_defs}"'
    select(is_prompt(.))
    | (.timestamp // "?") as $when
    | prompt_text(.) as $t
    | select($t != "")
    | "--- \($when)\n\($t)"
  ' "$src"
  exit 0
fi

jq -n -c --arg path "$src" "${jq_defs}"'
  # Timestamps carry milliseconds, which fromdateiso8601 refuses.
  def ts: sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601;

  # .message is an object on the records we care about but not on all of them,
  # so every reach into it is filtered by type rather than assumed.
  def tok($m; $k):
    $m | if type == "object"
         then (.usage | if type == "object" then (.[$k] // 0) else 0 end)
         else 0 end;
  def blocks($m): $m | objects | .content | arrays | .[];

  # A denial record carries a structured toolDenialKind (permission-rule,
  # user-rejected, automode-blocked, automode-unavailable); that decides. The
  # text is only a fallback for records without it -- a regex over the text
  # misfiled 18 of 26 real user rejections, whose wording varies ("parts
  # require approval", "was blocked"). A guard hook is spotted by its text
  # first, since the harness files it under permission-rule.
  def denial_kind($r; $t):
    if   $t | test("[a-z]+-guard: ")                        then "hook"
    elif $r.toolDenialKind == "permission-rule"             then "rule"
    elif $r.toolDenialKind == "user-rejected"               then "user"
    # Not `| strings`: on a record without the key that yields empty, the if
    # yields empty, the reduce step yields empty, and the accumulator is null
    # from then on -- the extractor dies on the next record with a message
    # about iterating null, far from the cause.
    elif (($r.toolDenialKind // "") | startswith("automode")) then "classifier"
    elif $t | test("auto mode classifier")                  then "classifier"
    elif $t | test("doesn.t want to proceed")               then "user"
    elif $t | test("has been denied|requires? approval|Permission to use|was blocked") then "rule"
    else null end;

  # What a command is trying to do, coarsely. Used only to decide whether a
  # Bash call after a denial is the same attempt in another form: rm -> git
  # clean, reset --hard -> reset, --command "UPDATE" -> --file. These are the
  # shapes actually seen; the list is deliberately short so that an ordinary
  # follow-up (git status after a refused rm) does not read as a retry.
  def intent($c): [
    (if $c | test("(^|[ ;&|(])(rm|trash)\\b|git +(-C +\\S+ +)?clean\\b|-delete\\b")        then "delete"  else empty end),
    (if $c | test("git +(-C +\\S+ +)?(reset|restore|checkout +--|stash +drop)\\b")        then "discard" else empty end),
    (if $c | test("git +(-C +\\S+ +)?push\\b")                                            then "push"    else empty end),
    (if $c | test("--remote\\b")                                                          then "remote"  else empty end),
    (if $c | test("(^|[ ;&|(])(env|printenv)\\b")                                         then "env"     else empty end),
    (if $c | test("(^|[ ;&|(])(pkill|kill)\\b")                                           then "kill"    else empty end)
  ];

  # Risk patterns over the whole command text. Heuristic (tier 2): a heredoc
  # body that happens to contain "rm -rf" trips it too. One count per command.
  def risk_kinds($c): [
    (if $c | test("(^|[ ;&|(])rm +-[a-zA-Z]*[rf]|git +(-C +\\S+ +)?clean +-[a-zA-Z]*f")  then "delete"        else empty end),
    (if $c | test("git +(-C +\\S+ +)?(reset +--hard|checkout +-- |restore\\b)")          then "discard"       else empty end),
    (if $c | test("git +(-C +\\S+ +)?push\\b.*(--force|-f\\b|--delete)")                  then "force_push"    else empty end),
    (if $c | test("(^|[ ;&|(])sudo\\b|chmod +777")                                        then "privilege"     else empty end),
    (if $c | test("curl[^|\\n]*\\|\\s*(ba|z)?sh\\b")                                       then "pipe_to_shell" else empty end),
    (if $c | test("--remote\\b.*\\b(UPDATE|DELETE|INSERT|DROP|ALTER)\\b")                  then "remote_write"  else empty end),
    (if $c | test("(^|[ ;&|(])(pkill|kill +-9)\\b")                                        then "kill"          else empty end),
    (if $c | test("--no-verify\\b")                                                        then "hooks_bypass"  else empty end),
    (if $c | test("oauth_token|\\.aws/credentials|/hosts\\.yml|\\.wrangler/config|(^|[ ;&|(])(env|printenv)\\b *(\\||$)|(^|[ /])\\.env(\\.[a-z]+)?\\b") then "credentials" else empty end)
  ];

  # Typed prompts that push back. A word list (tier 3), so it under-counts and
  # occasionally over-counts; するなら must not match するな.
  def is_correction($t):
    $t | test("いらない|いらん|不要|やめて|やめろ|違う|ちがう|戻して|やり直|だめ|ダメ|しないで|するな(?!ら)|勝手に|頼んでない|聞いてない|\\bdon.?t\\b|\\bdo not\\b|\\bstop\\b|\\bwrong\\b|\\brevert\\b|\\bundo\\b|not what I"; "i");

  reduce inputs as $r (
    {
      session_id: null, cwd: null, git_branch: null,
      cc_version: null, versions: {},
      started_at: null, ended_at: null,
      user_turns: 0, assistant_turns: 0, sidechain_turns: 0,
      tokens: { input: 0, output: 0, cache_creation: 0, cache_read: 0 },
      tools: {}, tool_results: {}, tool_result_bytes: {},
      errors: { bash_stderr: 0, interrupted: 0 },
      friction: { compactions: 0, interrupts: 0 },
      denials: { rule: 0, classifier: 0, user: 0, hook: 0 },
      retries_after_denial: 0,
      risky: {}, risky_commands: 0,
      interpreter_oneliners: 0, compound_cd: 0, absolute_bin: 0,
      corrections: 0,
      skills: {},
      mode: null, permission_mode: null,
      idmap: {}, idcmd: {}, pending: []
    };

      (if $r.sessionId then .session_id = $r.sessionId else . end)
    | (if $r.cwd then .cwd = $r.cwd else . end)
    | (if $r.gitBranch then .git_branch = $r.gitBranch else . end)
    # Keep the last version as what the session ran as, and the set as the
    # evidence that it spanned an upgrade -- a report that compares across a
    # version bump needs to know which sessions straddle one.
    | (if $r.version then (.cc_version = $r.version | .versions[$r.version] = true) else . end)
    | (if $r.timestamp then
           (if .started_at == null or $r.timestamp < .started_at then .started_at = $r.timestamp else . end)
         | (if .ended_at == null or $r.timestamp > .ended_at then .ended_at = $r.timestamp else . end)
       else . end)
    | (if $r.type == "mode" then .mode = $r.mode else . end)
    | (if $r.type == "permission-mode" then .permission_mode = $r.permissionMode else . end)

    # Only what the human typed counts as a turn -- see jq_defs above. An
    # interrupt is typed too (it is the human hitting escape), and counted
    # separately because it is one of the few unambiguous friction signals.
    | (if is_prompt($r) then
           .user_turns += 1
         | (if is_interrupt(prompt_text($r)) then .friction.interrupts += 1 else . end)
         | (if is_correction(prompt_text($r)) then .corrections += 1 else . end)
       else . end)
    # Each compaction means the context filled up once. Nine in one session is
    # a story the token totals alone do not tell.
    | (if $r.isCompactSummary == true then .friction.compactions += 1 else . end)

    | (if $r.type == "assistant" then
           .assistant_turns += 1
         # isSidechain is absent on some records and false on others, so this
         # asks `== true` rather than `!= false`.
         | (if $r.isSidechain == true then .sidechain_turns += 1 else . end)
         | (if $r.attributionSkill then .skills[$r.attributionSkill] = true else . end)
         | .tokens.input          += tok($r.message; "input_tokens")
         | .tokens.output         += tok($r.message; "output_tokens")
         | .tokens.cache_creation += tok($r.message; "cache_creation_input_tokens")
         | .tokens.cache_read     += tok($r.message; "cache_read_input_tokens")
         | reduce (blocks($r.message) | select(.type == "tool_use")) as $t (.;
               .tools[$t.name] = ((.tools[$t.name] // 0) + 1)
             | .idmap[$t.id]   = $t.name
             | (if $t.name == "Bash" then
                  (($t.input.command // "") | tostring) as $c
                  | .idcmd[$t.id] = $c
                  # A denial is a decision. This is the check for it being
                  # treated as an obstacle instead: the same attempt, same
                  # intent class or same text, within the next three calls.
                  | ([.pending[] | select(.left > 0)]) as $p
                  | ($p | map(select(.cmd == $c or (((.classes - (.classes - intent($c))) | length) > 0)))) as $hit
                  | .retries_after_denial += ($hit | length)
                  | .pending = (($p - $hit) | map(.left -= 1))
                  | (risk_kinds($c)) as $k
                  | (if ($k | length) > 0
                     then .risky_commands += 1
                        | reduce $k[] as $kk (.; .risky[$kk] = ((.risky[$kk] // 0) + 1))
                     else . end)
                  # This repo forbids interpreter one-liners and compound cd;
                  # an absolute /bin path is how a prefix rule gets sidestepped.
                  | (if $c | test("(^|[ ;&|])(python3?|node|perl|ruby) +-[ce]\\b") then .interpreter_oneliners += 1 else . end)
                  | (if ($c | split("\n")[0]) | test("^cd +[^;&|\n]*(&&|;)") then .compound_cd += 1 else . end)
                  | (if $c | test("(^|[ ;&|])/(usr/)?bin/[a-z]+\\b") then .absolute_bin += 1 else . end)
                else . end)
           )
       else . end)

    # Tool results are attributed through the id recorded at call time, never by
    # matching the shape of the result. Bash alone comes back under at least six
    # different key sets (gitOperation, staleReadFileStateHint, backgroundTaskId,
    # returnCodeInterpretation, timedOutAfterMs, ...), so shape matching drops
    # calls silently as new optional keys appear.
    | (if $r.type == "user" and $r.toolUseResult != null then
           (first(blocks($r.message) | select(.type == "tool_result") | .tool_use_id) // "unknown") as $tid
         | (.idmap[$tid] // "unknown") as $name
         | .tool_results[$name]      = ((.tool_results[$name] // 0) + 1)
         | (first(blocks($r.message) | select(.type == "tool_result")) // {}) as $blk
         | (($blk.content // "") | if type == "string" then . else (map(.text? // "") | join(" ")) end) as $txt
         # Size what the model was shown -- the tool_result block -- not the
         # harness-internal toolUseResult, which for Edit carries the whole
         # original file and a structured patch and ran 20-40x the block.
         | .tool_result_bytes[$name] = ((.tool_result_bytes[$name] // 0) + ($txt | utf8bytelength))
         # Denials live in the tool_result block, not in toolUseResult (which
         # is then a bare string). Only a denied Bash call can be retried.
         | (if $blk.is_error == true then
                (denial_kind($r; $txt)) as $kind
              | (if $kind != null then
                   .denials[$kind] += 1
                 | (if $name == "Bash" then
                      (.idcmd[$tid] // "") as $dc
                      | .pending += [{ cmd: $dc, classes: intent($dc), left: 3 }]
                    else . end)
                 else . end)
            else . end)
         # toolUseResult is sometimes a bare string.
         | (if ($r.toolUseResult | type) == "object" then
                (if $name == "Bash" and (($r.toolUseResult.stderr // "") | length) > 0
                   then .errors.bash_stderr += 1 else . end)
              | (if $r.toolUseResult.interrupted == true then .errors.interrupted += 1 else . end)
            else . end)
       else . end)
  )
  | {
      schema: 4,
      source_path: $path,
      session_id, cwd, git_branch,
      cc_version,
      cc_versions: (.versions | keys),
      started_at, ended_at,
      wall_seconds: (if .started_at and .ended_at
                     then ((.ended_at | ts) - (.started_at | ts))
                     else null end),
      user_turns, assistant_turns, sidechain_turns,
      tokens, tools, tool_results, tool_result_bytes, errors, friction,
      denials, retries_after_denial, risky, risky_commands,
      interpreter_oneliners, compound_cd, absolute_bin, corrections,
      skills: (.skills | keys),
      mode, permission_mode
    }
' "$src"
