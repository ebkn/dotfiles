# shell
brew 'zsh'

# tmux
# Keep the version in step with the pin in .github/workflows/lint-and-test.yml.
# agent-state.test.sh pins how values survive a round trip through `set-option`
# and a `-F` format, and tmux has changed how it renders non-printable bytes
# between releases -- so a version gap there is a green local run against a red
# CI one, on code nobody touched.
brew 'tmux'

# auto-reconnecting SSH
brew 'autossh'

# IDE
brew 'vim'
brew 'neovim'
brew 'tree-sitter-cli' # required by nvim-treesitter to compile parsers

# fuzzy finder
brew 'fzf'

# json
brew 'jq'
brew 'jo'

# rg
brew 'ripgrep'

# linter (bin/lint-shell runs it at default severity)
# Keep the version in step with the pin in .github/workflows/lint-and-test.yml.
# CI used the runner image's copy until that copy moved and started reporting a
# check this one does not, turning main red with no shell script changed.
brew 'shellcheck'

# shell formatter (bin/lint-shell enforces `shfmt -i 2 -ci`)
# Keep the version in step with the pin in .github/workflows/lint-and-test.yml,
# or local and CI disagree about what "formatted" means.
brew 'shfmt'

# static analysis (security)
brew 'semgrep'

# fly
brew 'flyctl'

# aws
brew 'awscli'

# git
brew 'tig'
brew 'ghq' # manage repository
brew 'git-secrets' # prevent commiting secrets
brew 'git-lfs' # LFS
brew 'gibo' # gitignore template
brew 'gnupg' # signing
brew 'pinentry-mac' if OS.mac? # signing

# colorized cat
brew 'bat'

# document converter (backs bin/read-doc; chosen over cmark-gfm for its
# built-in syntax highlighting, which avoids vendoring highlight.js here)
brew 'pandoc'

# better diff
brew 'difftastic'

# database cli
brew 'mycli'
brew 'pgcli'

# image processing (used by image.nvim for in-terminal image preview)
brew 'imagemagick'

# util
brew 'tree'
