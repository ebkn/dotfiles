<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs bin/pr-review-dispatch every 30s, handing queued review feedback to the
  session working on that branch by posting to that session's inbox socket.

  A SEPARATE agent from com.ebkn.pr-review-watch, not one job running both.
  This is the half that puts messages into your sessions, and being able to

      launchctl bootout gui/$UID/com.ebkn.pr-review-dispatch

  while notifications keep arriving is the whole reason for the split. The
  interval is shorter than the watcher's 60s because nothing here talks to
  GitHub -- it reads the local queue and the session registry under
  ~/.claude/sessions -- so checking often costs nothing.

  The PATH and `sh -c` notes in com.ebkn.pr-review-watch.plist apply verbatim:
  a launchd agent inherits none of the login shell's environment, and a login
  shell's path_helper would rebuild PATH from /etc/paths and drop the entry
  set here.

  Load with:  launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.ebkn.pr-review-dispatch.plist
  Status:     launchctl print gui/$UID/com.ebkn.pr-review-dispatch
  Unload:     launchctl bootout gui/$UID/com.ebkn.pr-review-dispatch
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ebkn.pr-review-dispatch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec env PATH="$HOME/.local/bin:$PATH" "$HOME/.local/bin/pr-review-dispatch"</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartInterval</key>
    <integer>30</integer>

    <!-- Nothing is owed at login: the queue is on disk and the next interval
         picks it up 30 seconds later. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/pr-review-dispatch.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/pr-review-dispatch.log</string>
</dict>
</plist>
