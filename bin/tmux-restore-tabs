#!/bin/zsh
#
# tmux-restore-tabs
#
# Restore wezterm tabs for all existing tmux sessions.
#
# Purpose:
#   When wezterm crashes or is closed unexpectedly, tmux sessions remain alive
#   in the background. This script quickly restores wezterm tabs for all those
#   sessions, saving you from manually opening tabs and attaching each one.
#
# Usage:
#   Run this script from within a wezterm tab that is already attached to a
#   tmux session. It will create new wezterm tabs for all other tmux sessions.
#
# Requirements:
#   - wezterm (with CLI support)
#   - tmux
#   - jq (for JSON parsing)
#

set -e

# After wezterm restarts, the WEZTERM_UNIX_SOCKET env var inside existing tmux
# sessions points to the old (now stale) socket. The symlink always points to
# the current socket, so we override the env var here.
export WEZTERM_UNIX_SOCKET=~/.local/share/wezterm/default-org.wezfurlong.wezterm

# Get all unattached tmux session names sorted by creation time (oldest first).
# This preserves the original tab order when restoring after a crash.
# Sessions that already have a client attached are skipped to avoid duplicates.
# ${(@f)...} splits output by newlines into array elements (zsh syntax).
#
# The name is everything after the first space, cut by position. It used to be
# found with awk's index($0, $3), which returns the name's FIRST occurrence on
# the line -- inside the timestamp for a numeric name like "35" on
# "1790660355 35" -- so the tab attached to a session that does not exist.
#
# Popup sessions (`_*`: bin/tmux-popup, bin/tmux-agent-view) are skipped. They
# outlive their popup unattached but never had a tab, so restoring one would
# open a tab on a popup's shell. Same glob as .tmux.conf's @in_popup and as
# `tmux-track-session adopt`; dropped here, before the empty check, so a server
# holding only popups reports nothing to restore.
sessions=()
for line in "${(@f)$(tmux list-sessions -f '#{==:#{session_attached},0}' -F '#{session_created} #{session_name}' 2>/dev/null | sort -s -n -k1,1)}"; do
  [[ -n "$line" ]] || continue
  [[ "${line#* }" == _* ]] && continue
  sessions+=("${line#* }")
done

if [[ ${#sessions[@]} -eq 0 || -z "${sessions[1]}" ]]; then
  echo "No unattached tmux sessions found"
  exit 1
fi

# If we're currently inside a tmux session, remember its name so we can skip it
# (no need to open a duplicate tab for the session we're already in).
current_session=""
if [[ -n "$TMUX" ]]; then
  current_session=$(tmux display-message -p '#S')
fi

# The pane the user ran this from, asked of WezTerm itself: the focused pane of
# the GUI client idle for the shortest time, i.e. the one just typed into.
#
# Neither obvious source works. `wezterm cli list`'s is_active is per TAB, so it
# is true for one pane in every tab and yielded a list of ids. And
# $WEZTERM_PANE, which `cli spawn` reads by default, is inherited from whenever
# the tmux server started -- after WezTerm restarts it names a pane of the old
# WezTerm, and every tab opened in a NEW WINDOW of its own.
current_pane=$(wezterm cli list-clients --format json |
  jq -r 'sort_by(.idle_time.secs, .idle_time.nanos) | .[0].focused_pane_id')

# Create a new wezterm tab for each tmux session (except the current one), in
# the window of the pane found above. `=` makes the target an exact name, not a
# prefix.
for session in "${sessions[@]}"; do
  if [[ "$session" != "$current_session" ]]; then
    wezterm cli spawn --pane-id "$current_pane" -- tmux attach -t "=$session" >/dev/null
  fi
done

# Return focus to the original tab where this script was executed.
wezterm cli activate-pane --pane-id "$current_pane"
