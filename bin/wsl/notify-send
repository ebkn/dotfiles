#!/bin/sh
# notify-send shim that emits OSC 9 to the host terminal.
#
# zsh-auto-notify calls libnotify's notify-send on Linux/WSL, which
# needs a DBus notification daemon (org.freedesktop.Notifications).
# WSL has none, so the call fails with a GDBus error. WezTerm
# supports OSC 9 system notifications on macOS and Windows, so this
# shim bypasses DBus entirely and writes OSC 9 to the controlling
# tty.
#
# Inside tmux the OSC must be wrapped in DCS tmux passthrough
# (\ePtmux;\e<seq>\e\\) and every embedded ESC must be doubled,
# otherwise tmux swallows the sequence instead of forwarding it to
# the outer terminal. allow-passthrough must also be on (set in
# .tmux.conf).
#
# Argument compatibility: parses libnotify-bin notify-send flags and
# extracts SUMMARY and BODY. Other flags (urgency, timeout, icon,
# etc.) are accepted and ignored — OSC 9 has no equivalent.

set -u

summary=
body=
# The first two positionals are SUMMARY and BODY; any more are ignored.
positional() {
  if [ -z "$summary" ]; then
    summary="$1"
  elif [ -z "$body" ]; then
    body="$1"
  fi
}
while [ $# -gt 0 ]; do
  case "$1" in
    # The value-taking options of libnotify master's tools/notify-send.c
    # (-n/--app-icon is newer than its 0.8.6 tag). -A and -n were missing, so
    # `notify-send -A Open "Build done"` showed "Open".
    -u | --urgency | -t | --expire-time | -i | --icon | -a | --app-name | -c | --category | -h | --hint | -r | --replace-id | -A | --action | -n | --app-icon | --id-fd | --selected-action-fd | --activation-token-fd)
      # Counted first rather than `shift 2 || break`: shift is a special
      # builtin, and in dash -- WSL's /bin/sh -- shifting past the end exits
      # the shell before `||` is reached.
      [ $# -ge 2 ] || break
      shift 2
      ;;
    --urgency=* | --expire-time=* | --icon=* | --app-name=* | --category=* | --hint=* | --replace-id=* | --action=* | --app-icon=*)
      shift
      ;;
    # libnotify's -e is --transient; -N and --hint-server are not its options
    # and were dropped (any other -* below is skipped the same way anyway).
    -p | --print-id | -w | --wait | -e | --transient)
      shift
      ;;
    --)
      # Everything after -- is positional. It used to break out without
      # reading them, so `notify-send -- "msg"` said nothing at all.
      shift
      for a in "$@"; do positional "$a"; done
      break
      ;;
    -*)
      shift
      ;;
    *)
      positional "$1"
      shift
      ;;
  esac
done

[ -n "$summary" ] || exit 0

if [ -n "$body" ]; then
  msg="$summary: $body"
else
  msg="$summary"
fi

esc=$(printf '\033')
# Only the test sets this: run from a real terminal, the suite would otherwise
# raise real notifications.
tty="${NOTIFY_SEND_TTY:-/dev/tty}"

# The braces matter: with no controlling terminal the error comes from the
# redirection, not from printf, so a bare `>"$tty" 2>/dev/null` still printed
# it. Same idiom as bin/read-doc and bin/autossh-ssh.
if [ -n "${TMUX-}" ]; then
  inner=$(printf '%s]9;%s\007' "$esc" "$msg" | sed "s/${esc}/${esc}${esc}/g")
  # \134 = octal for backslash; combined with the trailing ESC this is
  # the DCS String Terminator (ST = ESC \).
  { printf '%sPtmux;%s%s\134' "$esc" "$inner" "$esc" >"$tty"; } 2>/dev/null || true
else
  { printf '%s]9;%s\007' "$esc" "$msg" >"$tty"; } 2>/dev/null || true
fi
