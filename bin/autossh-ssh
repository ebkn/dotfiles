#!/bin/sh
# autossh-ssh: the `ssh` that autossh runs, pointed at by AUTOSSH_PATH from
# myssh (zsh/ssh.zsh). It exists to own the screen between reconnect attempts.
#
# When the link drops, the terminal still shows the remote tmux's last frame,
# and two things scribble on it: ssh's diagnostic per attempt (autossh retries
# about once a second), and -- the half that looks like a separate bug entirely
# -- a flood of raw SGR reports, because the remote tmux left mouse tracking on
# with nobody consuming it.
#
# Being AUTOSSH_PATH is what keeps this a *shim*: autossh keeps its restart
# policy, backoff and exit handling, and this only takes the one hook that runs
# per attempt. It is deliberately not named `ssh`, since it finds the real
# binary with `command -v ssh` and a shim called ssh would find itself.
#
# The first attempt is left completely alone: that one is the initial connect,
# where ssh's own output is the useful thing on screen (host key prompts,
# "Permission denied") and there is no stale frame to cover.
#
# With AUTOSSH_NOTICE_STATE unset this is a transparent `exec ssh "$@"`, which
# is what a caller that is not myssh gets.
#
# See bin/autossh-ssh.md. Tested by bin/autossh-ssh.test.sh.

state="${AUTOSSH_NOTICE_STATE:-}"
host="${AUTOSSH_NOTICE_HOST:-the remote}"
# The terminal the notice is drawn on. Only the test sets it: run from a real
# terminal, the suite would otherwise clear it and hide its cursor.
tty="${AUTOSSH_NOTICE_TTY:-/dev/tty}"

ssh_bin=$(command -v ssh 2>/dev/null)
[ -n "$ssh_bin" ] || ssh_bin=/usr/bin/ssh

[ -n "$state" ] || exec "$ssh_bin" "$@"

# Attempt counter. The file is per-myssh-invocation (myssh creates and removes
# it), so nothing needs to key off a pid: autossh execs this afresh every
# attempt, and the file is the only memory between them. It holds the count and
# when the previous attempt started, "<n> <epoch>".
attempt=0
started=""
[ -f "$state" ] && read -r attempt started <"$state" 2>/dev/null
case "$attempt" in
  '' | *[!0-9]*) attempt=0 ;;
esac
case "$started" in
  *[!0-9]*) started="" ;;
esac
attempt=$((attempt + 1))
now=$(date +%s)
printf '%s %s' "$attempt" "$now" >"$state" 2>/dev/null

# Named after the state file because myssh (zsh/ssh.zsh) owns both and removes
# exactly "$state" and "$state.log" when the connection ends. A scratch file
# added or renamed here leaks one temp file per connection unless that cleanup
# line changes with it.
log="$state.log"
[ "$attempt" -eq 1 ] && exec "$ssh_bin" "$@"

# The last thing ssh said. This is why its stderr is redirected below rather
# than discarded: a fatal, non-transient failure -- a changed host key, a
# refused key -- otherwise retries forever behind a line that cheerfully says
# "reconnecting", with the one message explaining why nowhere on screen.
detail=""
[ -s "$log" ] && detail=$(grep -v '^[[:space:]]*$' "$log" 2>/dev/null | tail -1)

rows=24
cols=80
# Braced, for the reason spelled out at the terminal write below: with no
# controlling terminal the "Device not configured" comes from the redirection,
# so `stty ... 2>/dev/null` does not suppress it.
{ size=$(stty size <"$tty"); } 2>/dev/null
case "$size" in
  [0-9]*' '[0-9]*) rows=${size%% *} cols=${size##* } ;;
esac

esc=$(printf '\033')
# centred <row> <text> [<style>]
# The style is a separate argument so its escape bytes are not counted as width:
# folded into the text, `ESC[2m`/`ESC[0m` pushed the detail line four columns
# left of centre.
centred() {
  col=$(((cols - ${#2}) / 2 + 1))
  [ "$col" -lt 1 ] && col=1
  if [ -n "${3:-}" ]; then
    printf '%s[%d;%dH%s%s%s[0m' "$esc" "$1" "$col" "$3" "$2" "$esc"
  else
    printf '%s[%d;%dH%s' "$esc" "$1" "$col" "$2"
  fi
}

# The first notice of an outage clears the screen and shuts the mouse up; later
# attempts only repaint, so retrying every second does not flicker the whole
# screen. The reset is the sequence ssh::decorate_off sends on the way out (the
# five mouse tracking modes plus bracketed paste) -- sent here on the way *in*,
# because the flood starts the moment the remote stops reading. The remote
# re-enables what it wants when the client attaches again.
#
# "First notice of an outage" is not only attempt 2. The counter lives as long
# as myssh, so when a connection that came back is lost AGAIN the next attempt
# is 3 or more, and keyed on attempt 2 alone it left the stale frame and the
# flood on screen. Nothing here sees whether the previous attempt connected
# (this execs ssh), so its duration stands in: a failed attempt ends within
# seconds, while one that ran OUTAGE_GAP or longer was a session. It errs both
# ways: a slow failed attempt or a long autossh backoff costs one extra clear,
# and a session that dropped within OUTAGE_GAP of connecting is taken for a
# failed attempt, leaving its frame and mouse modes up.
OUTAGE_GAP=30
new_outage=false
[ "$attempt" -eq 2 ] && new_outage=true
[ -n "$started" ] && [ $((now - started)) -ge "$OUTAGE_GAP" ] && new_outage=true
frame=""
$new_outage &&
  frame="${esc}[?9l${esc}[?1000l${esc}[?1002l${esc}[?1003l${esc}[?1006l${esc}[?2004l${esc}[0m${esc}[2J"
frame="${frame}${esc}[?25l"
frame="${frame}$(centred $((rows / 2)) "reconnecting to ${host} … (${attempt})")"
[ -n "$detail" ] && frame="${frame}$(centred $((rows / 2 + 2)) "$detail" "${esc}[2m")"

# Write to the controlling terminal, falling back to stderr. `[ -w /dev/tty ]`
# is not the test to use: it passes with no controlling terminal and the write
# then fails with ENXIO. The braces matter too -- "Device not configured" comes
# from the redirection rather than from printf, so a bare 2>/dev/null on the
# command would not suppress it. Same idiom as bin/read-doc.
{ printf '%s' "$frame" >"$tty"; } 2>/dev/null || printf '%s' "$frame" >&2

# stderr to the log so the next attempt can quote it. stdout is left alone: it
# is the session itself.
exec "$ssh_bin" "$@" 2>"$log"
