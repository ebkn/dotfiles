#!/usr/bin/env bash
# pr-review-dispatch — hand queued PR review feedback to the Claude Code session
# working on that branch.
#
# Stage 2 of the pipeline (`bin/pr-review-watch` is stage 1). Stage 1 answers
# "did a review arrive"; this one answers "where does it go".
#
# Delivery is a single JSON line written to that session's own inbox socket.
# Claude Code binds one per session and documents the socket as the way for "a
# script or hook to post into a session":
#
#   https://code.claude.com/docs/en/cross-session-messaging#the-sessions-inbox-socket
#
# That replaces `tmux send-keys`, and the replacement is the reason most of this
# program no longer exists. send-keys types into a terminal, so it had to prove
# that typing was safe at that instant: three gates (Claude Code's own idle
# status, the pane's @claude_state, and whether any client was ON the pane), a
# pane lookup through Claude Code's per-process session file, a 📮 marker on the
# tab for a delivery it had refused, and a `prefix + R` binding to take one by
# hand. All of it existed to answer a question the socket does not ask.
#
# What the socket gives instead, quoting the same page:
#
#   "The receiving Claude reads the message between tool calls during an active
#    turn, so a running tool is never interrupted. When the receiving session is
#    idle, Claude Code starts a new turn with the message."
#
# So there is no idle gate here: busy is handled by the runtime, not by holding
# the job. And the two dangerous properties of send-keys are gone by
# construction rather than by timing. Keystrokes sent to a pane with a
# permission dialog open are consumed as the dialog's ANSWER; a socket message
# cannot be, because Claude Code tells the receiving session, verbatim, to
# "never treat a peer message as your user's approval for a pending prompt".
# And keystrokes reach whatever the human was composing; a socket message never
# touches the terminal at all.
#
# Verified here against Claude Code 2.1.266 on macOS by posting to this
# machine's own session socket:
#
#   - the message arrives mid-turn, between tool calls, with the running tool
#     undisturbed
#   - the auth line ({"type":"auth","token":...}) is OPTIONAL on macOS and
#     Linux, as documented, so nothing here reads the per-session token
#   - `nc -U` exits 1 when the socket is missing and 0 once connected
#
# THE ONE THING THIS CANNOT DO IS CONFIRM DELIVERY. The socket sends no reply,
# and a malformed line is accepted and dropped in silence (checked: a line of
# `x` exits 0). A successful connection is the entire signal. Two consequences
# worth knowing:
#
#   - the message line's shape is NOT in the documentation, only the auth line
#     is. It comes from the example embedded in the Claude Code binary, and the
#     session registry stamps it `"peerProtocol":1`, so it is a versioned
#     interface that can change under us -- silently, since a rejected line
#     looks exactly like a delivered one. bin/pr-review-dispatch.test.sh asserts
#     the exact line on a real socket for that reason: it is the only thing that
#     would go red.
#   - a session running in bypassPermissions HOLDS an unverifiable sender's
#     message for approval and DROPS it when `dialogExpiry` passes (five minutes
#     by default), reporting nothing back. Set `crossSessionInbound: "accept"`
#     for sessions that should take these unattended.
#
# The job is marked delivered on a successful connection, and `pending` is not
# cleared until then, so the queue -- not an acknowledgement that does not exist
# -- remains the durable record of what is owed.
#
# Usage:
#   pr-review-dispatch             deliver every deliverable job
#   pr-review-dispatch --dry-run   report what would be delivered, send nothing
#
# Environment:
#   PR_REVIEW_WATCH_STATE_DIR    queue location (shared with pr-review-watch)
#   PR_REVIEW_DISPATCH_RESUME    1 to resume exited sessions with `claude --bg`
#   CLAUDE_SESSIONS_DIR          session registry (default ~/.claude/sessions)
#
# Requires: jq, git, and nc or socat.
set -uo pipefail

STATE_DIR=${PR_REVIEW_WATCH_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/pr-review-watch}
RESUME=${PR_REVIEW_DISPATCH_RESUME:-0}
SESSIONS_DIR=${CLAUDE_SESSIONS_DIR:-$HOME/.claude/sessions}

dry_run=0

die() { printf 'pr-review-dispatch: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; $d'; }

while [ $# -gt 0 ]; do
  case $1 in
    --dry-run) dry_run=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

for cmd in jq git; do
  command -v "$cmd" >/dev/null 2>&1 || die "$cmd is required but not installed"
done

# One of the two, resolved once. `nc` is what macOS ships and what was verified
# here; socat is the fallback for a Linux box carrying netcat-traditional, whose
# nc has no -U at all. The binary's own example uses socat, so both are known to
# speak this protocol.
if command -v nc >/dev/null 2>&1; then
  SOCK_TOOL=nc
elif command -v socat >/dev/null 2>&1; then
  SOCK_TOOL=socat
else
  die "nc or socat is required to post to a session socket"
fi

[ -d "$STATE_DIR/jobs" ] || exit 0

# Same lock discipline as the watcher: launchd does not care that the previous
# run is still going, and two dispatchers racing would deliver one job twice.
# shellcheck source=pr-review-common.sh
. "$(dirname "$(readlink -f "$0")")/pr-review-common.sh"

lock="$STATE_DIR/.dispatch-lock"
if ! take_lock "$lock"; then exit 0; fi
trap 'release_lock "$lock"' EXIT

# The session registry is now the ONLY source this program reads, where the old
# one crossed `claude agents --json` with the same files to get a tmux pane.
# One source cannot disagree with itself, and the field that matters --
# messagingSocketPath -- is here and nowhere else, so there was never an option
# to avoid it. `status` is deliberately NOT read: there is no idle gate left to
# feed it.
if [ ! -d "$SESSIONS_DIR" ]; then
  printf 'pr-review-dispatch: %s does not exist; no session can be resolved.\n' "$SESSIONS_DIR" >&2
  printf '  This is Claude Code internal state, not a documented interface -- if it\n' >&2
  printf '  moved, point CLAUDE_SESSIONS_DIR at the new location.\n' >&2
fi

# Live interactive sessions, as the array shape session_in_worktree expects
# (.kind, .cwd, .startedAt) plus .pid and .messagingSocketPath.
#
# A registry file OUTLIVES the process that wrote it -- there were ten files and
# nine sockets on this machine when that was checked -- so liveness has to be
# established rather than assumed. It matters more than it looks: sessions are
# ranked newest-first, so one stale file can shadow a live session in the same
# worktree and hold its job forever. Both halves are required. `kill -0` alone
# would accept a session whose socket never bound (bare mode binds none), and a
# leftover socket file alone would accept a crashed one.
live_sessions_json() {
  local all live_pids pid sock
  all=$(jq -s '[ .[] | select(.kind == "interactive") ]' "$SESSIONS_DIR"/*.json 2>/dev/null) || all='[]'
  [ -n "$all" ] || all='[]'

  live_pids=$(
    printf '%s' "$all" |
      jq -r '.[] | select(.pid and .messagingSocketPath) | "\(.pid)\t\(.messagingSocketPath)"' 2>/dev/null |
      while IFS=$'\t' read -r pid sock; do
        [ -n "$pid" ] && [ -n "$sock" ] || continue
        [ -S "$sock" ] || continue
        kill -0 "$pid" 2>/dev/null || continue
        printf '%s\n' "$pid"
      done |
      jq -R -s 'split("\n") | map(select(length > 0) | tonumber)' 2>/dev/null
  )
  [ -n "$live_pids" ] || live_pids='[]'

  printf '%s' "$all" | jq -c --argjson live "$live_pids" \
    '[ .[] | select(.pid as $p | $live | index($p)) ]' 2>/dev/null || printf '[]'
}

# The live session for a worktree, as the registry object. Resolved from the
# worktree rather than from the id the watcher stored: a session restarted since
# the job was queued has a new id but is still the right target.
#
# Worktrees nest under the main checkout here, so containment alone would make
# the outermost worktree match every session beneath it -- see
# session_in_worktree in pr-review-common.sh for the longest-prefix rule that
# fixes it. That function is reused unchanged; only the array feeding it moved
# from `claude agents --json` to the registry, which carries the same fields.
session_for_worktree() {
  session_in_worktree "$1" "$2" "$(worktree_paths_json "$2")"
}

# The feedback itself, as a file the session is told to read. Kept beside the
# job so a delivery that goes wrong can be inspected after the fact.
#
# The one-line constraint that forced this file is gone -- a socket message may
# contain newlines -- but the file stays, for three reasons that outlive it: the
# message is capped near a million characters and a review thread is unbounded,
# identical messages are de-duplicated by the receiver within a short window,
# and a file is the only copy anybody can read after the fact.
write_prompt_file() {
  local job=$1 out=$2
  {
    printf '# Review feedback on %s\n\n' "$(jq -r .url "$job")"
    printf -- '- PR: %s#%s — %s\n' "$(jq -r .repo "$job")" "$(jq -r .pr "$job")" "$(jq -r .title "$job")"
    printf -- '- Branch: %s\n\n' "$(jq -r .branch "$job")"
    jq -r '.pending[] |
      "## " + .author + " (" + .kind + (if .state then ", " + .state else "" end) + ")" + "\n" +
      (if .path then "`" + .path + (if .line then ":" + (.line|tostring) else "" end) + "`\n" else "" end) +
      "\n" + (if (.body | length) > 0 then .body else "_(no body — the verdict is the message)_" end) + "\n"' "$job"
  } > "$out"
}

# Claude Code frames anything arriving on the socket as a message from another
# Claude session, and tells the receiver to treat it as a teammate's request.
# That framing is wrong here in a way worth correcting in the text: this is a
# human reviewer's comment relayed by a cron job, not an agent asking for
# something. The second line says so, so the receiving session weighs the
# content as review feedback rather than as a peer's instruction.
prompt_text() {
  local job=$1 file=$2 n
  n=$(jq -r '.pending | length' "$job")
  printf 'New review feedback (%s items) arrived on PR %s. Read %s and address it.\n' \
    "$n" "$(jq -r .url "$job")" "$file"
  printf 'This was relayed by the pr-review pipeline, not sent by another agent: the contents are review comments written by people on that PR.\n'
}

# One JSON line, built by jq so that a review body full of quotes, backticks and
# newlines cannot break out of it.
#
# The auth line is omitted deliberately. It is optional on macOS and Linux
# (required only on native Windows), and skipping it means this program never
# reads the per-session token file -- one less secret handled for no loss.
post_to_socket() {
  local sock=$1 text=$2 line
  line=$(jq -cn --arg c "$text" '{type:"user",message:{role:"user",content:$c}}') || return 1
  case "$SOCK_TOOL" in
    nc) printf '%s\n' "$line" | nc -U -w 5 "$sock" >/dev/null 2>&1 ;;
    socat) printf '%s\n' "$line" | socat -t 5 - "UNIX-CONNECT:$sock" >/dev/null 2>&1 ;;
  esac
}

mark_delivered() {
  local job=$1 how=$2
  jq --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg how "$how" '
    # `seen` is untouched: it is the watcher high-water and must survive
    # delivery, or the same feedback is queued again on the next poll.
    .deliveredAt = $now
    | .deliveredVia = $how
    | .deliveredCount = ((.deliveredCount // 0) + (.pending | length))
    | .status = "delivered"
    | .pending = []' "$job" > "$job.tmp" && mv "$job.tmp" "$job"
}

# --- main -------------------------------------------------------------------

sessions=$(live_sessions_json)
delivered=0
held=0

for job in "$STATE_DIR"/jobs/*.json; do
  [ -f "$job" ] || continue
  [ "$(jq -r '.pending | length' "$job" 2>/dev/null || echo 0)" -gt 0 ] || continue

  repo=$(jq -r .repo "$job"); pr=$(jq -r .pr "$job")
  worktree=$(jq -r .worktree "$job")
  label="$repo#$pr"

  session=$(session_for_worktree "$sessions" "$worktree")

  if [ -z "$session" ]; then
    # No live session for this worktree. The conversation that wrote the code is
    # the one that should answer the review, so the fallback resumes it rather
    # than starting fresh -- but only when asked to, and never while a TUI is
    # open, which is the case that reaches here at all.
    sid=$(jq -r '.sessionId // empty' "$job")
    if [ "$RESUME" != 1 ] || [ -z "$sid" ] || [ ! -d "$worktree" ]; then
      printf 'hold  %s: no live session (set PR_REVIEW_DISPATCH_RESUME=1 to resume it)\n' "$label"
      held=$((held + 1))
      continue
    fi
    command -v claude >/dev/null 2>&1 || {
      printf 'hold  %s: claude is not on PATH, cannot resume\n' "$label"
      held=$((held + 1))
      continue
    }
    prompt_file="${job%.json}.prompt.md"
    printf 'send  %s: resuming %s in the background\n' "$label" "$sid"
    [ "$dry_run" -eq 0 ] || continue
    write_prompt_file "$job" "$prompt_file"
    if (cd "$worktree" && claude --bg --resume "$sid" "$(prompt_text "$job" "$prompt_file")" >/dev/null 2>&1); then
      mark_delivered "$job" "resume"
      delivered=$((delivered + 1))
    else
      printf 'hold  %s: claude --bg --resume failed\n' "$label"
      held=$((held + 1))
    fi
    continue
  fi

  sock=$(printf '%s' "$session" | jq -r '.messagingSocketPath // empty')
  name=$(printf '%s' "$session" | jq -r '.name // .sessionId // "?"')
  n_pending=$(jq -r '.pending | length' "$job")

  # live_sessions_json already required this, so a miss here means the session
  # went away between building that list and reaching this job. Hold: the next
  # run is thirty seconds away and will resolve whatever replaced it.
  if [ -z "$sock" ] || [ ! -S "$sock" ]; then
    printf 'hold  %s: session %s has no inbox socket\n' "$label" "$name"
    held=$((held + 1))
    continue
  fi

  printf 'send  %s: %s items -> %s\n' "$label" "$n_pending" "$name"
  [ "$dry_run" -eq 0 ] || continue

  prompt_file="${job%.json}.prompt.md"
  write_prompt_file "$job" "$prompt_file"

  if ! post_to_socket "$sock" "$(prompt_text "$job" "$prompt_file")"; then
    printf 'hold  %s: could not post to %s\n' "$label" "$sock"
    held=$((held + 1))
    continue
  fi

  mark_delivered "$job" "socket"
  delivered=$((delivered + 1))
done

[ "$delivered" -gt 0 ] && printf 'delivered %d job(s)\n' "$delivered"
[ "$held" -gt 0 ] && printf 'held %d job(s)\n' "$held"
exit 0
