#!/bin/zsh
#
# tmux-pane-titles
#
# Label each pane in the current tmux window (ssh `≫` > `w:<worktree>` >
# `b:<branch>` > directory basename), drop duplicates, and set the
# comma-joined labels as the window name.
#
# Called only from zsh (chpwd and precmd hooks in zsh/directory.zsh, and the
# ssh/myssh wrappers in zsh/ssh.zsh), always with no arguments, so it acts on
# the caller's own window. It used to also run from tmux server-side hooks
# (after-new-window / after-split-window / window-layout-changed), which passed
# a window id and needed a debounce because a layout change fires them in
# bursts. Those hooks caused a SIGSEGV in tty_keys_next -- run-shell forking
# while tty input was being processed -- and were replaced by the zsh-side pane
# count check; .tmux.conf now unsets them explicitly on reload. With no caller
# left that can burst, both the window-id argument and the debounce were dead
# code, so they are gone. Restoring either means restoring a caller that needs
# it, not just the flag.
#

# Targeted at $TMUX_PANE explicitly. Left to itself, tmux does NOT resolve "the
# current window" to the one the calling shell lives in: measured on 3.7c, a
# command run inside a background window's pane, with a client attached,
# resolves the client's ACTIVE window. So a hook firing in a background window
# -- a long command finishing there -- renamed the window being looked at.
# Without $TMUX_PANE (not run from a pane) the untargeted form is all there is.
target=()
[[ -n "${TMUX_PANE:-}" ]] && target=(-t "$TMUX_PANE")
panes=$(tmux list-panes "${target[@]}" -F '#{b:pane_current_path}	#{@ssh_host}	#{@git_worktree}	#{@git_branch}' 2>/dev/null) || exit 0
title=$(printf '%s\n' "$panes" | awk -F'\t' '
# Drop the type prefix before the first "/" (feature/x -> /x, fix/x -> /x).
# The type carries almost no information once the name itself is visible, so
# spending tab width on even two chars of it is not worth it; the leading "/"
# is kept so the label still reads as a branch path rather than a bare word.
# Names without a "/" are left intact. Applied to both worktree and branch
# labels since both display a branch name.
function strip_type(b,   n) {
  n = index(b, "/")
  if (n > 0) return substr(b, n)
  return b
}
{
  dir = $1
  ssh = $2
  wt = $3
  br = $4
  # ssh: host name dropped in favour of a ≫ marker to keep the label
  # short. Multiple ssh hosts in one window collapse to a single entry.
  if (ssh != "")     label = "≫"
  else if (wt != "") label = "w:" strip_type(wt)
  else if (br != "") label = "b:" strip_type(br)
  else               label = dir
  # The label goes in as an argument, never as the format: a branch named
  # fix/50%-off would otherwise make "%-o" a conversion with nothing to convert.
  if (!seen[label]++) { printf "%s%s", sep, label; sep = "," }
}')
[[ -n "$title" ]] && tmux rename-window "${target[@]}" -- "$title" 2>/dev/null
exit 0
