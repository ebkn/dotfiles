#!/bin/sh
# tmux-popup: run a tmux session inside a display-popup, one per WezTerm tab.
#
# Called as the shell-command of the `display-popup -E` bindings in .tmux.conf
# (prefix + p / t / o), so that the rules those bindings share live in one place
# instead of being repeated, with shell quoting, in three tmux config lines.
#
# Usage: tmux-popup <name> [command...]
#
# Why the "_<name>_<id>" scheme, and why the id comes from $TMUX rather than a
# #{...} format: see bin/tmux-popup.md.
set -eu

if [ $# -lt 1 ]; then
  echo "usage: ${0##*/} <name> [command...]" >&2
  exit 2
fi

if [ -z "${TMUX:-}" ]; then
  echo "${0##*/}: not inside tmux" >&2
  exit 1
fi

name=$1
shift

exec tmux new-session -A -s "_${name}_${TMUX##*,}" -c "$PWD" "$@"
