#!/usr/bin/env bash
# skill-eval — run the eval cases of a skill owned by this repo.
#
# A case lives in root/.agents/skills/<skill>/evals/<case>/ as three files
# (prompt.md / scaffold.sh / assert.sh). This builds a throwaway fixture, runs
# `claude -p` against it with the skill's own allowed-tools, and grades the
# result with the case's assert.sh.
#
# The point is to answer "did that SKILL.md edit make the behaviour better or
# worse", which is otherwise unanswerable: a skill's behaviour is not visible in
# the diff, and trying it once by hand proves nothing about a non-deterministic
# model. Ported from tetsunavi-monorepo's scripts/skill_eval; see
# bin/skill-eval.md for what was left behind and why.
#
# Usage:
#   bin/skill-eval <skill> [<case> ...] [--runs N] [--model M] [--keep]
#
#   --runs N   runs per case (default 1). The output wobbles; raise this to see
#              how much before trusting a single green run
#   --model M  model for `claude -p` (default sonnet)
#   --keep     leave the working directory behind, to investigate a FAIL
#
# THIS SPENDS MONEY. Every run calls the API on the caller's Claude Code
# credentials, capped per run by --max-budget-usd (default 1 USD).
#
# Artifacts land in tmp/skill-eval/<skill>/<case>/<timestamp>/run-N/.
#
# The working directory is created outside the repo (mktemp). Inside it, Claude
# Code would read this repo's CLAUDE.md and grade the fixture against dotfiles'
# conventions instead of the skill's own contract.
#
# Environment variables (mostly for bin/skill-eval.test.sh):
#   SKILL_EVAL_CLAUDE_BIN   command to run instead of `claude` (also used by check_llm)
#   SKILL_EVAL_JUDGE_MODEL  model for the check_llm judge (default haiku)
#   SKILL_EVAL_SKILLS_DIR   directory to read skills from
#   SKILL_EVAL_OUT_DIR      directory to write artifacts to
#   SKILL_EVAL_MAX_TURNS    default --max-turns for `claude -p` (default 40)
#   SKILL_EVAL_BUDGET_USD   default --max-budget-usd for `claude -p` (default 1)
#
# A case overrides both in prompt.md's frontmatter (max_turns / budget_usd),
# because a long scenario is a property of the case, not of the machine running
# it.

set -eo pipefail

repo_root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
lib_dir="$repo_root/bin"
claude_bin="${SKILL_EVAL_CLAUDE_BIN:-claude}"
skills_dir="${SKILL_EVAL_SKILLS_DIR:-$repo_root/root/.agents/skills}"
out_root="${SKILL_EVAL_OUT_DIR:-$repo_root/tmp/skill-eval}"
max_turns="${SKILL_EVAL_MAX_TURNS:-40}"
budget_usd="${SKILL_EVAL_BUDGET_USD:-1}"

usage() {
  printf 'usage: %s <skill> [<case> ...] [--runs N] [--model M] [--keep]\n' "$0" >&2
  exit 1
}

skill=""
runs=1
model="sonnet"
keep=0
cases=()
while [ $# -gt 0 ]; do
  case "$1" in
    --runs)
      runs="${2:-}"
      shift 2
      ;;
    --model)
      model="${2:-}"
      shift 2
      ;;
    --keep)
      keep=1
      shift
      ;;
    -h | --help) usage ;;
    -*)
      printf 'unknown option: %s\n' "$1" >&2
      usage
      ;;
    *)
      if [ -z "$skill" ]; then
        skill="$1"
      else
        cases+=("$1")
      fi
      shift
      ;;
  esac
done

if [ -z "$skill" ]; then
  usage
fi
if ! [[ "$runs" =~ ^[1-9][0-9]*$ ]]; then
  printf -- '--runs takes an integer of 1 or more (got: %s)\n' "$runs" >&2
  exit 1
fi

skill_dir="$skills_dir/$skill"
evals_dir="$skill_dir/evals"
if [ ! -f "$skill_dir/SKILL.md" ]; then
  printf 'no such skill: %s/SKILL.md\n' "$skill_dir" >&2
  exit 1
fi
if [ ! -d "$evals_dir" ]; then
  printf 'no eval cases: %s\n' "$evals_dir" >&2
  exit 1
fi
if ! command -v "$claude_bin" >/dev/null 2>&1; then
  printf 'claude not found: %s\n' "$claude_bin" >&2
  exit 1
fi
if ! command -v jq >/dev/null 2>&1; then
  printf 'jq is required\n' >&2
  exit 1
fi

if [ ${#cases[@]} -eq 0 ]; then
  for dir in "$evals_dir"/*/; do
    [ -d "$dir" ] || continue
    cases+=("$(basename "$dir")")
  done
fi
if [ ${#cases[@]} -eq 0 ]; then
  printf 'no eval cases: %s\n' "$evals_dir" >&2
  exit 1
fi
for case_name in "${cases[@]}"; do
  for required in prompt.md scaffold.sh assert.sh; do
    if [ ! -f "$evals_dir/$case_name/$required" ]; then
      printf 'case %s has no %s\n' "$case_name" "$required" >&2
      exit 1
    fi
  done
done

# Run the skill under its own allowed-tools, so a call outside them is refused
# and recorded as a permission denial the case can assert on. Read the value
# straight out of the frontmatter rather than restating it here: a copy would
# drift, and it would drift towards being more permissive than the skill.
allowed_line="$(sed -n 's/^allowed-tools:[[:space:]]*//p' "$skill_dir/SKILL.md")"
skill_allowed_tools=()
if [ -n "$allowed_line" ]; then
  while IFS= read -r tool; do
    [ -n "$tool" ] && skill_allowed_tools+=("$tool")
  done <<<"${allowed_line//, /$'\n'}"
fi

# The YAML frontmatter of prompt.md (`claude plugin eval` metadata) is not part
# of the prompt.
read_prompt() {
  awk '
    NR == 1 && $0 == "---" { skip = 1; next }
    skip && $0 == "---" { skip = 0; next }
    !skip { print }
  ' "$1"
}

# One scalar value out of prompt.md's frontmatter.
prompt_meta() {
  awk -v key="$2" '
    NR == 1 && $0 == "---" { inside = 1; next }
    inside && $0 == "---" { exit }
    inside && index($0, key ":") == 1 {
      sub("^" key ":[ \t]*", "")
      print
      exit
    }
  ' "$1"
}

timestamp="$(date +%Y%m%d-%H%M%S)"
summary_file="$(mktemp)"
trap 'rm -f "$summary_file"' EXIT

any_failed=0
for case_name in "${cases[@]}"; do
  case_dir="$evals_dir/$case_name"
  prompt="$(read_prompt "$case_dir/prompt.md")"

  # A case that measures whether the skill starts on its own needs tools the
  # skill itself does not have: writing the tests is the scenario, and
  # review-test may not write. Those go in prompt.md's frontmatter as
  # allowed_tools and are added on top. The skill's own boundary is never
  # widened here -- only the scenario around it.
  case_allowed_tools=("${skill_allowed_tools[@]}")
  extra_allowed_line="$(prompt_meta "$case_dir/prompt.md" allowed_tools)"
  if [ -n "$extra_allowed_line" ]; then
    while IFS= read -r tool; do
      [ -n "$tool" ] && case_allowed_tools+=("$tool")
    done <<<"${extra_allowed_line//, /$'\n'}"
  fi

  # A case whose scenario is longer than the defaults declares its own ceiling.
  # Without this the case is simply unrunnable: `claude -p` stops at --max-turns
  # and exits non-zero, which the runner grades as FAIL, so the case reports a
  # broken skill when what ran out was the harness. Raising the global default
  # instead would spend that ceiling on every other case too.
  case_max_turns="$(prompt_meta "$case_dir/prompt.md" max_turns)"
  [ -n "$case_max_turns" ] || case_max_turns="$max_turns"
  case_budget_usd="$(prompt_meta "$case_dir/prompt.md" budget_usd)"
  [ -n "$case_budget_usd" ] || case_budget_usd="$budget_usd"
  if ! [[ "$case_max_turns" =~ ^[1-9][0-9]*$ ]]; then
    printf 'case %s: max_turns takes an integer of 1 or more (got: %s)\n' "$case_name" "$case_max_turns" >&2
    exit 1
  fi
  if ! [[ "$case_budget_usd" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    printf 'case %s: budget_usd takes a number (got: %s)\n' "$case_name" "$case_budget_usd" >&2
    exit 1
  fi

  case_passed=0
  case_cost_file="$(mktemp)"
  case_duration_ms=0

  for ((i = 1; i <= runs; i++)); do
    artifacts="$out_root/$skill/$case_name/$timestamp/run-$i"
    mkdir -p "$artifacts"
    work="$(mktemp -d)"

    # Carry in the skill but not its evals/: with evals/ present the model can
    # read the grader while answering the prompt.
    mkdir -p "$work/.claude/skills"
    cp -R "$skill_dir" "$work/.claude/skills/$skill"
    rm -rf "$work/.claude/skills/$skill/evals"

    (cd "$work" && SKILL_EVAL_LIB_DIR="$lib_dir" SKILL_EVAL_REPO_ROOT="$repo_root" bash "$case_dir/scaffold.sh")

    # The .claude/ we just carried in, and bin/ where a scaffold puts stubs,
    # are not part of the fixture. Left untracked they show up in git status,
    # and a skill reading that status treats them as the user's work.
    if [ -d "$work/.git" ]; then
      printf '.claude/\nbin/\n' >>"$work/.git/info/exclude"
    fi

    # --allowedTools is variadic: passing it with nothing swallows the next
    # option name as a tool. Skills with no allowed-tools get no flag.
    claude_args=(
      -p "$prompt"
      --model "$model"
      --output-format stream-json --verbose
      --permission-mode acceptEdits
      --permission-prompts none
      --setting-sources project
      --strict-mcp-config
      --no-session-persistence
      --max-turns "$case_max_turns"
      --max-budget-usd "$case_budget_usd"
    )
    if [ ${#case_allowed_tools[@]} -gt 0 ]; then
      claude_args+=(--allowedTools "${case_allowed_tools[@]}")
    fi

    # stdin is closed because the prompt goes in as an argument; left open,
    # `claude -p` waits three seconds before giving up on it.
    claude_exit=0
    if (
      cd "$work" &&
        PATH="$work/bin:$PATH" "$claude_bin" "${claude_args[@]}" \
          </dev/null >"$artifacts/transcript.jsonl" 2>"$artifacts/claude.stderr"
    ); then
      :
    else
      claude_exit=$?
      printf 'claude -p exited %s (%s run-%s); see %s\n' \
        "$claude_exit" "$case_name" "$i" "$artifacts/claude.stderr" >&2
    fi

    jq -c 'select(.type == "result")' "$artifacts/transcript.jsonl" | tail -n 1 >"$artifacts/result.json" || true
    if [ ! -s "$artifacts/result.json" ]; then
      echo '{}' >"$artifacts/result.json"
    fi

    if [ -d "$work/.git" ]; then
      git -C "$work" log --format='%H%n%B---' eval-base..HEAD >"$artifacts/git-log.txt" 2>/dev/null || true
      git -C "$work" status --porcelain >"$artifacts/git-status.txt" 2>/dev/null || true
    fi
    if [ -d "$work/bin" ]; then
      cp -R "$work/bin" "$artifacts/bin"
    fi

    assert_exit=0
    : >"$artifacts/judge-cost.txt"
    if ! (
      cd "$work" &&
        SKILL_EVAL_TRANSCRIPT="$artifacts/transcript.jsonl" \
          SKILL_EVAL_RESULT_FILE="$artifacts/result.json" \
          SKILL_EVAL_LIB_DIR="$lib_dir" \
          SKILL_EVAL_REPO_ROOT="$repo_root" \
          SKILL_EVAL_CLAUDE_BIN="$claude_bin" \
          SKILL_EVAL_JUDGE_COST_FILE="$artifacts/judge-cost.txt" \
          bash "$case_dir/assert.sh" >"$artifacts/assert.log" 2>&1
    ); then
      assert_exit=1
    fi
    # A run where `claude -p` itself failed (budget, auth, turn limit) is not a
    # graded run. Reporting PASS because the assertions happened to hold paints
    # a failed run green.
    if [ "$claude_exit" -ne 0 ]; then
      printf 'FAIL  claude -p exited %s\n' "$claude_exit" >>"$artifacts/assert.log"
      assert_exit=1
    fi

    if [ "$assert_exit" -eq 0 ]; then
      case_passed=$((case_passed + 1))
      status="PASS"
    else
      any_failed=1
      status="FAIL"
    fi
    printf '[%s] %s/%s run-%s\n' "$status" "$skill" "$case_name" "$i"
    if [ "$assert_exit" -ne 0 ]; then
      grep '^FAIL' "$artifacts/assert.log" | sed 's/^/    /' || true
    fi

    jq -r '.total_cost_usd // 0' "$artifacts/result.json" >>"$case_cost_file"
    cat "$artifacts/judge-cost.txt" >>"$case_cost_file"
    duration_ms="$(jq -r '.duration_ms // 0' "$artifacts/result.json")"
    case_duration_ms=$((case_duration_ms + duration_ms))

    if [ "$keep" -eq 1 ]; then
      printf '    work: %s\n' "$work"
    else
      rm -rf "$work"
    fi
  done

  case_cost="$(jq -s 'add // 0' "$case_cost_file")"
  rm -f "$case_cost_file"
  printf '%s\t%d/%d\t%.3f\t%d\n' "$case_name" "$case_passed" "$runs" "$case_cost" "$((case_duration_ms / 1000))" >>"$summary_file"
done

printf '\nskill: %s  model: %s  runs: %s\n' "$skill" "$model" "$runs"
printf '%-32s %-8s %-10s %s\n' "case" "passed" "cost(USD)" "time(s)"
while IFS=$'\t' read -r name passed cost secs; do
  printf '%-32s %-8s %-10s %s\n' "$name" "$passed" "$cost" "$secs"
done <"$summary_file"
printf 'artifacts: %s/%s/<case>/%s/\n' "$out_root" "$skill" "$timestamp"

exit "$any_failed"
