#!/usr/bin/env bash
# tmux-cheatsheet: the key bindings worth remembering, grouped into columns.
#
# Bound to prefix + ?, opened in a display-popup. The status bar carries a
# "C-q ?:help" hint so the key that opens this is itself discoverable -- a list
# you cannot remember how to reach is no better than no list.
#
# The list is DERIVED from the running tmux server, never hand-maintained:
# `tmux list-keys -N` prints only bindings that carry a note (`bind -N`), so
# adding a note in .tmux.conf is the single act that both documents a binding
# and puts it here. A cheatsheet stored as its own list would drift from the
# config the first time a key moved.
#
# Two classes of entry, separated by rules that are cheap and explicit:
#
#   1. Our prefix bindings. tmux ships notes on its own prefix keys too, so the
#      table alone cannot separate ours. Ours are tagged: the note reads
#      "<category>: <description>" (lowercase tag, colon, space) and the tag
#      becomes the group heading. tmux's built-in notes are sentence-style
#      ("Split window vertically") and never match. If upstream ever adds a
#      note shaped like a tag it lands in the wrong group -- cosmetic only.
#   2. Our copy-mode-vi bindings. tmux ships NO notes outside the prefix table
#      (verified: `list-keys -N -T copy-mode-vi` is empty on a stock server),
#      so everything listed there is ours and needs no tag.
#
# tmux's own ~85 prefix keys are EXCLUDED unless --all is given. They are what
# makes a single list unreadable, and they are not what gets forgotten -- this
# exists because your own bindings are the ones with no upstream manual. The
# footer points at `C-q :list-keys -N` for the complete set.
#
# Read-only, by construction: it runs `tmux list-keys` and nothing else. A list
# you open to remember "how do I kill this pane" must not kill the pane, so
# there is deliberately no way to execute a binding from here.

set -euo pipefail

# `[ ... ] && x=1` would be the last command of a `set -e` script line and exit
# it outright when the test fails, so these stay as if-statements.
show_all=0
force_cols=""
while [ $# -gt 0 ]; do
  case "$1" in
    --all) show_all=1 ;;
    # Pretend the popup is this wide. Exists so the column packing can be
    # verified without a pty -- see the testing note in CLAUDE.md.
    --width) shift; force_cols="${1:-}" ;;
    *) printf 'usage: %s [--all] [--width N]\n' "${0##*/}" >&2; exit 2 ;;
  esac
  shift
done

# Popup geometry, read from the tty itself (TIOCGWINSZ). `$(tput cols)` is the
# obvious idiom and is WRONG here, verified in a real popup: tput measures the
# terminal on its stdout, and command substitution makes that a pipe, so it
# falls back to the terminfo entry and reports 80x24 with exit status 0 -- no
# error, just every popup packed into the one column this layout exists to
# avoid. `stty size` reads /dev/tty explicitly and is immune. tput stays only
# as the fallback for when /dev/tty cannot be opened at all, where its 80 is at
# least an honest guess.
if size=$(stty size 2>/dev/null </dev/tty); then
  lines=${size%% *}
  cols=${size##* }
else
  cols=$(tput cols 2>/dev/null || echo 80)
  lines=$(tput lines 2>/dev/null || echo 24)
fi
if [ -n "$force_cols" ]; then
  cols=$force_cols
fi

# parse_table TABLE SHOW_PREFIX CATEGORY_MODE
#
# `list-keys -N` prints "<prefix> <key><padding><note>" -- and it prepends the
# prefix for EVERY table, including copy-mode-vi, where the key is reached by
# being in copy mode and never by pressing C-q. So the key is always the first
# two tokens, but showing both is only correct for the prefix table:
# SHOW_PREFIX=0 drops the misleading "C-q " from copy-mode rows, which would
# otherwise teach a chord that does not work. The note is whatever follows;
# its internal runs of spaces are collapsed, which is only ever tmux's padding.
#
# Emits TAB-separated "category<TAB>key<TAB>description". Tabs, not columns:
# the layout below needs the fields apart, and every downstream sort keys on a
# field rather than a character offset, so nothing depends on padding widths.
#
# CATEGORY_MODE:
#   tagged  - keep notes shaped "cat: desc", split them, drop the rest
#   builtin - keep only notes NOT shaped that way, category "tmux"
#   LITERAL - keep every note, use CATEGORY_MODE itself as the category
parse_table() {
  tmux list-keys -N -T "$1" 2>/dev/null | awk -v showpfx="$2" -v mode="$3" '
    {
      key = (showpfx ? $1 " " $2 : $2)
      note = ""
      for (i = 3; i <= NF; i++) note = note (i > 3 ? " " : "") $i
      if (note == "") next

      tagged = match(note, /^[a-z][a-z-]*: /)
      if (mode == "tagged") {
        if (!tagged) next
        cat = substr(note, 1, RLENGTH - 2)
        desc = substr(note, RLENGTH + 1)
      } else if (mode == "builtin") {
        if (tagged) next
        cat = "tmux"
        desc = note
      } else {
        cat = mode
        desc = note
      }
      printf "%s\t%s\t%s\n", cat, key, desc
    }'
}

collect() {
  # Sorted by category then key so groups form and each group reads in a
  # stable order; list-keys order is tmux's own key order, which says nothing.
  # -f folds case, keeping the resize keys (H) next to the focus keys (h)
  # instead of in a separate uppercase run.
  {
    parse_table prefix 1 tagged
    parse_table copy-mode-vi 0 copy-mode
    if [ "$show_all" -eq 1 ]; then parse_table prefix 1 builtin; fi
  } | sort -f -t"$(printf '\t')" -k1,1 -k2,2
}

# Lay the groups out in as many columns as the popup is actually wide enough
# for. Column widths are measured PER COLUMN, not once for the whole page: a
# single long description would otherwise set the width of every column and cost
# a column that the real content had room for.
#
# So the count cannot be computed in one division -- it depends on which groups
# land where, which depends on the count. The loop tries each candidate from
# widest down, packs it for real, measures it, and takes the first that fits.
#
# Packing is balanced (columns filled to an even height) and never splits a
# group across columns: a heading with its keys in the next column is worse
# than an uneven page.
layout() {
  awk -F'\t' -v width="$cols" '
    # Length of group g as it is rendered: its heading, its keys, and the blank
    # line that separates it from the next. Every part of the packer has to
    # agree on this or a column overflows by exactly the separators it forgot.
    function glen(g) {
      return gend[g] - gstart[g] + 1 + (g < ng ? 1 : 0)
    }

    # Can the groups be laid out in c columns none taller than h? Greedy is
    # optimal here because groups keep their order and cannot be split.
    function fits(h, c,   g, col, used, L) {
      col = 1; used = 0
      for (g = 1; g <= ng; g++) {
        L = glen(g)
        if (L > h) return 0
        if (used + L > h) { col++; used = 0 }
        used += L
      }
      return (col <= c)
    }

    # Shortest height that c columns can achieve, by binary search over the
    # feasibility test above. This is what keeps the columns even: filling them
    # to a ceil(total / c) target instead makes the first oversized group push
    # every later group into the final column, which was the whole bug.
    function minheight(c,   lo, hi, mid, res) {
      lo = minh; hi = nl; res = nl
      while (lo <= hi) {
        mid = int((lo + hi) / 2)
        if (fits(mid, c)) { res = mid; hi = mid - 1 } else lo = mid + 1
      }
      return res
    }

    # Lay the groups out at height h, filling cell[] and colw[] and returning
    # the total rendered width. Widths are per column, not one maximum for the
    # page: a single long description would otherwise widen every column and
    # cost a column the real content had room for.
    function pack(h,   g, col, used, i, total, w, L) {
      for (i in cell) delete cell[i]
      for (i in colw) delete colw[i]
      col = 1; used = 0; height = 0
      for (g = 1; g <= ng; g++) {
        L = glen(g)
        if (used > 0 && used + L > h) { col++; used = 0 }
        for (i = gstart[g]; i <= gend[g]; i++) {
          # `cell[col SUBSEP ++used]` is NOT equivalent: the one true awk parses
          # `SUBSEP ++used` as `SUBSEP++ used`, post-incrementing SUBSEP and
          # never touching the counter, so every cell lands on one key and the
          # page comes out empty. Increment on its own line and the ambiguity
          # cannot arise.
          used++
          cell[col, used] = line[i]
          w = length(line[i]); if (w > colw[col]) colw[col] = w
        }
        if (g < ng) { used++; cell[col, used] = "" }
        if (used > height) height = used
      }
      ncols = col
      total = 0
      for (i = 1; i <= ncols; i++) total += colw[i]
      return total + GUTTER * (ncols - 1)
    }

    BEGIN { GUTTER = 4 }

    { cat[NR] = $1; key[NR] = $2; desc[NR] = $3; n = NR }

    END {
      if (n == 0) { print "  (no annotated bindings -- add -N notes in .tmux.conf)"; exit }

      kw = 0
      for (i = 1; i <= n; i++) if (length(key[i]) > kw) kw = length(key[i])

      nl = 0; ng = 0; prev = ""
      for (i = 1; i <= n; i++) {
        if (cat[i] != prev) {
          if (prev != "") line[++nl] = ""
          ng++; gstart[ng] = nl + 1
          line[++nl] = toupper(cat[i])
          prev = cat[i]
        }
        line[++nl] = sprintf("  %-*s  %s", kw, key[i], desc[i])
        gend[ng] = nl
      }

      minh = 0
      for (g = 1; g <= ng; g++) if (glen(g) > minh) minh = glen(g)

      # How many columns is not a free choice. The page can never be shorter
      # than its tallest group, so ceil(total / tallest) is the count that
      # reaches that floor and any more is pure whitespace -- a 288-column
      # popup otherwise lands on six columns, half of them one line deep. Step
      # down from there until the packing actually fits the popup width.
      c = int(nl / minh); if (nl % minh) c++
      if (c > ng) c = ng
      if (c < 1) c = 1
      while (c > 1 && pack(minheight(c)) > width) c--
      pack(minheight(c))

      for (r = 1; r <= height; r++) {
        out = ""
        for (col = 1; col <= ncols; col++) {
          v = ((col, r) in cell) ? cell[col, r] : ""
          out = out sprintf("%-*s", (col < ncols ? colw[col] + GUTTER : 0), v)
        }
        sub(/ +$/, "", out)
        print out
      }
    }'
}

page=$(collect | layout)
if [ "$show_all" -eq 0 ]; then
  page="$page

  all tmux keys: C-q :list-keys -N     describe one key: C-q /"
fi

# The popup is a fixed size, so anything taller has to scroll. less quits on q
# and needs no "press a key" prompt; the short case gets one, because with -E
# the popup dies the moment this script exits.
if [ "$(printf '%s\n' "$page" | wc -l)" -ge "$lines" ]; then
  printf '%s\n' "$page" | "${PAGER:-less}"
else
  printf '%s\n' "$page"
  printf '\n  (any key to close) '
  read -rsn1 || true
fi
