#!/usr/bin/env bash
# tmux-agents: list every Claude Code session by state and jump to the one you pick.
#
# Bound to prefix + a, which opens it in a display-popup. The state itself is
# published by ~/.claude/hooks/agent-state.sh as tmux pane user options; this
# script only reads them, so it stays correct as long as that contract holds.
#
# Takes no arguments. It derives the calling client from $TMUX because a popup
# has no attached client of its own and cannot be handed one: display-popup
# expands #{...} formats only in -d, never in the shell-command, so
# `#{client_name}` would arrive as that literal string and every tmux call
# taking it would fail quietly.
#
# Scope covers this machine plus every host reachable through an open `myssh`
# pane — the same dotfiles run there, so the remote panes carry the same
# options.
#
# EVERYTHING BEFORE THE PICKER IS ON THE LATENCY PATH: the popup is already on
# screen by the time this starts, so the cost *is* the process count (~5ms per
# tmux round-trip, ~1.6ms per spawn, no real work to speak of). Do not add a
# convenient pipeline stage here without reading the measurements in
# bin/tmux-agents.md, which also covers the jump path, the ctrl-o gate, the
# remote listing and why there is deliberately no age cutoff.

set -euo pipefail

# tmux does not interpret \t in -F, so the separators must be literal tabs;
# $'' supplies them. The same string is sent to remote hosts verbatim.
readonly FMT=$'#{session_name}\t#{window_id}\t#{pane_id}\t#{window_name}\t#{@claude_state}\t#{@claude_since}\t#{@claude_note}\t#{@claude_agents}\t#{@claude_session_id}'

# Used to build the formats above and to split the rows back apart below, so it
# has to be a real character in the script text.
#
# Every tmux call whose output is split on it passes -u. A tmux client with no
# UTF-8 locale prints control characters in a -F format as `_`, TAB included,
# and launchd starts `--sync` with no LANG, LC_ALL or LC_CTYPE at all: each row
# then parsed as one field, no pane looked bound to a session, and every tick
# returned early having corrected nothing -- the picker green, the tab red, exit
# 0 and an empty log. -u is a flag rather than an exported locale because a
# locale name that exists on macOS need not exist on Linux, and a flag adds no
# process to the latency path.
readonly TAB=$'\t'

# @claude_agents holds one record per actor in the pane — the main thread plus
# every running subagent — because hooks fire inside subagents too (see
# agent-state.sh). Records are separated by ASCII RS and their fields by US: a
# record carries a note taken from a question or a permission prompt, so any
# printable delimiter would eventually turn up inside one and split a row.
#
# @claude_state and friends stay the *aggregate* over those records, which is
# what the tab glyph reads. This script prefers the listing when it is there and
# falls back to the aggregate when it is not — a pane whose session predates the
# hook that publishes it, and any remote host whose dotfiles are older.
readonly RS=$'\036'
readonly US=$'\037'

# Separates the two halves of the single stream correct_rows feeds to awk. Made
# of the same control characters for the same reason: a note is arbitrary text,
# and any printable sentinel would eventually arrive inside one.
readonly SENTINEL=$'\036\037\036agents\036\037\036'

# Seconds between refreshes while the picker is open. Each one costs a collect
# plus ~140ms of `claude agents --json`, so this is a comfort/cost dial, not a
# correctness one: the list is correct the moment it is drawn either way.
readonly REFRESH=2

now=$(date +%s)

# The calling client is resolved after a selection is made, not here: it is
# needed only by msg() and the answer view, both post-picker, and a tmux
# round-trip on the latency path for a value nobody may read is the most
# expensive kind of eager evaluation. ${outer_client:+...} tolerates it empty.

# This script's own absolute path. Both the enter binding (which re-enters it as
# --jump-check) and the answer view need it: the first because fzf runs a
# transform through $SHELL, the second because that hop runs under
# `tmux run-shell`, which uses the tmux server's environment -- so $PATH cannot
# be relied on to hold ~/.local/bin in either case.
self=$0
case $self in
  */*) ;;
  *) self=$(command -v -- "$self") ;;
esac
self="$(cd "$(dirname "$self")" && pwd)/$(basename "$self")"
view="$(dirname "$self")/tmux-agent-view"

outer_client=""
msg() { tmux display-message ${outer_client:+-c "$outer_client"} "$1" 2>/dev/null || true; }

# --- where enter would land ---------------------------------------------------

# resolve_jump <key field> — work out whether enter can do anything with this
# row, and where it would go. Sets rj_reason to a human sentence when it cannot;
# everything else is only meaningful when rj_reason is empty.
#
# It exists as a function because two callers need the SAME answer: the enter
# binding, which asks through --jump-check below so it can refuse a row without
# closing the picker, and the jump itself further down. Anything the picker
# refuses must be refused for a reason the jump agrees with, or enter would
# accept a row that then does nothing.
rj_reason=""
rj_pane=""
rj_tty=""
rj_tab=""
rj_remote_note=""
resolve_jump() {
  local key=$1 host window_id pane_id state local_target client client_session
  IFS='|' read -r host window_id pane_id state <<<"$key"
  rj_reason=""
  rj_remote_note=""

  if [ -n "$host" ]; then
    # A remote agent lives in the remote tmux, which this client cannot focus.
    # Jump to the local pane holding that ssh connection instead, and name the
    # remote window so the last hop is obvious.
    local_target=$(
      tmux -u list-panes -a -F $'#{pane_id}\t#{window_id}\t#{@ssh_host}' 2>/dev/null |
        awk -F'\t' -v h="$host" '$3 == h { print $2 "\t" $1; exit }'
    ) || true
    if [ -z "$local_target" ]; then
      rj_reason="no local pane is connected to $host"
      return 0
    fi
    IFS=$'\t' read -r window_id pane_id <<<"$local_target"
    rj_remote_note=" (remote window: $host)"
  fi
  rj_pane=$pane_id

  # One WezTerm tab holds one tmux window, each through its own client, so the
  # right move is to raise that tab — not to repoint the current client at
  # another window, which would leave two tabs showing the same thing. tmux's
  # client_tty and WezTerm's tty_name are the same device, which is what links
  # them.
  client=$(
    tmux -u list-clients -F $'#{client_tty}\t#{window_id}\t#{client_session}' 2>/dev/null |
      awk -F'\t' -v w="$window_id" '$2 == w { print $1 "\t" $3; exit }'
  ) || true
  IFS=$'\t' read -r rj_tty client_session <<<"$client"
  if [ -z "$rj_tty" ]; then
    rj_reason="nothing is showing that window — C-q w switches this tab"
    return 0
  fi

  # An ssh client is never a WezTerm tab, so the CLI is not run at all. Read
  # from the *session* environment, never from $SSH_CONNECTION in this process:
  # that is the tmux server's environment, which says nothing about the client
  # showing that window now. show-environment prints "-NAME" for a variable
  # unset there, so only the "NAME=value" shape counts.
  case "$(tmux show-environment -t "$client_session" SSH_CONNECTION 2>/dev/null)" in
    SSH_CONNECTION=*)
      rj_reason="that window is shown over ssh, not by WezTerm — C-q w switches this tab"
      return 0
      ;;
  esac

  # --no-auto-start is load-bearing: without it `wezterm cli list` tries to
  # START a mux server before giving up — 3.0-3.4s against 0.00s, on exactly the
  # hosts where "no tab" is the normal answer. It costs nothing in the success
  # case, since the default already prefers a running gui instance. Asserted by
  # the test, because a missing flag is otherwise invisible: only slower.
  rj_tab=""
  if command -v wezterm >/dev/null 2>&1; then
    rj_tab=$(
      wezterm cli --no-auto-start list --format json 2>/dev/null |
        jq -r --arg t "$rj_tty" 'map(select(.tty_name == $t)) | .[0].tab_id // empty'
    ) || true
  fi
  if [ -z "$rj_tab" ]; then
    # Nothing to raise, and deliberately no `switch-client` fallback: that
    # repoints the tab you are sitting in, leaving two clients on one session —
    # the state bin/tmux-session-swap exists to prevent. prefix + w is the key
    # for changing what this tab shows.
    rj_reason="no WezTerm tab shows that window here — C-q w switches this tab"
  fi
}

# --jump-check <key field> — the enter binding's half of the above. Prints the
# fzf actions: accept when the row can be jumped to, otherwise only a header,
# which leaves the picker standing with the reason on it. Refusing after the
# picker has closed would be a popup that vanishes and a message on a status
# line behind it. Runs before the listing below, so a keypress costs one process
# plus resolve_jump's tmux calls, not a second collect.
if [ "${1:-}" = "--jump-check" ]; then
  resolve_jump "${2:-}"
  if [ -n "$rj_reason" ]; then
    printf 'change-header(enter: %s)\n' "$rj_reason"
  else
    printf 'print()+accept\n'
  fi
  exit 0
fi

# --answer-first <client> — prefix + A. The picker's ctrl-o with the picking
# taken out: collect, rank, and open the answer view on the top blocked row
# without ever drawing a list.
#
# It is a separate key rather than an option on prefix + a because the two
# answer different questions. `a` is "show me what is running"; `A` is the one
# move you make when the tab bar has gone red and there is nothing to choose
# between — the ranking already puts the agent blocked longest on top, which is
# the row you would have picked. Drawing a popup only to accept its first row
# would be a flash of a list nobody reads.
#
# The client is passed in, unlike prefix + a, because this does not run in a
# popup: `run-shell` DOES expand #{...} in its command, so the binding can hand
# over #{client_name} — and it must, since a run-shell child's $TMUX names the
# server, not which of its clients pressed the key.
answer_client=""
if [ "${1:-}" = "--answer-first" ]; then
  answer_client=${2:-}
  if [ -z "$answer_client" ]; then
    echo "usage: ${0##*/} --answer-first <client>" >&2
    exit 2
  fi
fi

# --- collect -----------------------------------------------------------------

# collect_rows — every pane on this machine and on each reachable myssh host,
# one row each, in the shape the render pass below expects.
#
# A function because the picker needs this answer more than once: once to fill
# the list, and again on every refresh while it is open. Called through $(...),
# so the temp dir it may create is cleaned up by the subshell's own EXIT trap.
#
# `collect_rows local` skips the remote fan-out. --sync runs on a timer, and an
# ssh round trip per tick is not a cost a background poller may impose — nor a
# useful one, since a remote pane's session is known only to the remote machine
# and could not be corrected from here anyway.
collect_rows() {
  local only_local=${1:-} rows hosts row ssh_host rest mine tmpdir i host normalised

  # One tmux call for everything. Field 1 is the host — empty means this machine,
  # which keeps local and remote rows in one shape for the awk pass below — and
  # the leading tab in the format supplies it, so no sed pass is needed to prefix
  # it. The last two fields carry the ssh decoration, so the listing that finds remote
  # hosts is the same listing that is about to be rendered rather than a second
  # round-trip; the awk pass never looks at them.
  rows=$(tmux -u list-panes -a -F "${TAB}${FMT}${TAB}#{@ssh_my_machine}${TAB}#{@ssh_host}" 2>/dev/null) || true

  # Only `myssh` panes are queried: @ssh_my_machine marks a host the user declared
  # to be theirs, i.e. one running tmux and these dotfiles. Plain `ssh` panes may
  # be jump boxes or CI runners where this query is meaningless or unwelcome.
  #
  # Done with shell builtins over the rows already in hand: `awk | sort -u` reads
  # better, but it is two processes and a second pane listing spent on what is
  # usually the empty answer.
  #
  # The two columns are peeled off the END with parameter expansion, because
  # `IFS=$'\t' read -r a b c ...` DOES NOT WORK HERE. Tab is an IFS *whitespace*
  # character however narrow IFS is, so the shell collapses runs of tabs and
  # strips leading ones — and an ordinary pane has @claude_state, @claude_since
  # and @claude_note all unset, so a ten-field row arrives as six with everything
  # after the first gap shifted. awk -F'\t' does not do this, which is why the
  # awk version never had to know.
  hosts=""
  while IFS= read -r row; do
    ssh_host=${row##*"$TAB"}
    rest=${row%"$TAB"*}
    mine=${rest##*"$TAB"}
    [ -n "$mine" ] && [ -n "$ssh_host" ] || continue
    case " $hosts " in
      *" $ssh_host "*) ;;
      *) hosts="$hosts $ssh_host" ;;
    esac
  done <<<"$rows"

  [ "$only_local" = local ] && hosts=""

  if [ -n "$hosts" ]; then
    # Temp files exist only on this path. They are needed to collect the hosts in
    # parallel, but with no remote host there is nothing to collect, and mktemp
    # plus the cat that follows are ~4ms the common case should not pay for.
    tmpdir=$(mktemp -d)

    i=0
    for host in $hosts; do
      i=$((i + 1))
      # A dedicated ControlMaster socket, never the one myssh uses: myssh runs with
      # ControlPath=none precisely so autossh owns its own reconnection, and sharing
      # a socket with it would interfere. ConnectTimeout keeps a host that is asleep
      # or off-network from stalling the popup.
      #
      # The host column is written by the remote tmux, through the format, rather
      # than by a local sed per host.
      ssh -o BatchMode=yes \
        -o ConnectTimeout=3 \
        -o ControlMaster=auto \
        -o ControlPath="$HOME/.ssh/cm-agents-%r@%h:%p" \
        -o ControlPersist=60s \
        "$host" "tmux -u list-panes -a -F '${host}${TAB}${FMT}'" \
        >"$tmpdir/remote.$i" 2>/dev/null &
    done
    # Bare `wait` always reports success, so an unreachable host cannot trip set -e.
    wait

    rows="$rows"$'\n'"$(cat "$tmpdir"/remote.* 2>/dev/null || true)"
    # Removed here rather than from an EXIT trap: this runs inside $(...), so
    # the trap would fire after the function returned and its local $tmpdir had
    # gone -- an unbound-variable error under `set -u`, on stderr, on every run
    # that has a remote host.
    rm -rf "$tmpdir"
  fi

  # An older tmux does not store the RS/US separators: measured on 3.4,
  # `set-option` rewrites each one as the four literal characters \036 / \037,
  # out of `show-options` as much as out of a format, so it is the option store
  # rather than the format expansion. 3.7c round-trips them untouched.
  #
  # Normalised here, at the boundary where rows enter this script, so nothing
  # downstream has to know: over ssh the REMOTE tmux expands the format, so the
  # version under a row is not the version running this code, and a local pane
  # is no different if this machine is the old one. Untreated, the whole listing
  # arrives as a single record whose first field is not a recognised state, so a
  # blocked subagent renders as a green idle row -- not merely garbled, actively
  # reassuring, which is the one outcome this list exists to prevent.
  #
  # Parameter expansion, not sed: collect_rows is the latency-critical path and
  # its cost is process count. The outer guard keeps even the string work off the
  # common path, where no escape is present anywhere.
  #
  # Per row, and that is the point rather than a detail: a note is text from a
  # prompt, so one can legitimately contain `\036` as characters, and rewriting
  # those would split the record in half -- the confusion the raw bytes were
  # chosen to avoid, arriving from the other direction. A listing written by a
  # tmux that stores the bytes always carries at least one real RS, because the
  # producer terminates every record with one, so the presence of a raw RS is
  # what tells "escaped by an old tmux" from "text that looks like an escape".
  # It cannot be decided for the run as a whole: a local pane on the current
  # tmux and a remote one on an older tmux arrive in the same listing and need
  # opposite treatment.
  case $rows in
    *'\036'* | *'\037'*)
      normalised=""
      while IFS= read -r row; do
        case $row in
          *"$RS"*) ;;
          *)
            row=${row//'\036'/$RS}
            row=${row//'\037'/$US}
            ;;
        esac
        normalised="$normalised$row"$'\n'
      done <<<"$rows"
      rows=${normalised%$'\n'}
      ;;
  esac

  printf '%s\n' "$rows"
}

# --- filter, rank, render ----------------------------------------------------

# Fields: 1 host, 2 session, 3 window_id, 4 pane_id, 5 window_name, 6 state,
#         7 since, 8 note, 9 per-actor listing, 10 session id. Local rows carry
#         11 and 12 too (the ssh decoration); nothing reads them here.
#
# Filtering, ranking and rendering are one awk pass. They used to be two, with
# the sort between them, which meant the second pass re-parsed the rows the
# first had just written — a process and a full re-scan to save nothing.
#
# The sort key is emitted as two leading numeric columns and stripped after
# sorting: the blocked ones first (that is the whole point of the list), then
# oldest within each rank, so the session blocked longest floats to the top.
#
# KEY (the first field of what survives the cut, hidden from fzf via --with-nth)
# carries what the jump needs. "|" is safe as its separator: tmux ids are @N / %N
# and hosts are ssh aliases.
# --- correct against the session's own view ----------------------------------

# correct_rows <rows> — merge in what `claude agents --json` says, for the panes
# whose session this machine can name.
#
# WHY THIS EXISTS. The pane options are transitions reported by hooks, and there
# are three transitions no hook reports at all: a permission prompt being
# answered, a dialog being dismissed, and a turn being interrupted. The
# documented event list has none of them, so a state built from hooks alone goes
# stale in exactly the situations this list exists to show — 🛑 lingers for the
# whole of an approved long command, and an interrupted session keeps whatever
# glyph it had until its next prompt. See agent-state.md.
#
# `claude agents --json` is the documented way to read the live answer (the
# agent-view docs name a status bar as the use case, and call the files
# underneath unstable). It costs ~140ms, which is why it is paid on the refresh
# and never before the picker appears.
#
# Only local rows are corrected. A remote pane's session is known to the remote
# machine, and asking it would mean an ssh round trip per refresh.
correct_rows() { # $1 rows
  local agents map
  # Every failure here degrades to the uncorrected rows: an indicator that
  # disappears when a CLI changes is worse than one that is late.
  if ! agents=$(claude agents --json 2>/dev/null); then
    printf '%s\n' "$1"
    return 0
  fi
  if ! map=$(printf '%s' "$agents" | jq -r '
    .[]? | select(.sessionId != null)
    | [.sessionId, (.status // ""), (.waitingFor // "")] | @tsv' 2>/dev/null); then
    printf '%s\n' "$1"
    return 0
  fi

  # One awk pass over the map and the rows, separated by a sentinel line, rather
  # than a temp file: this runs on every refresh tick, and the rows cannot
  # contain a line equal to a string of control characters.
  printf '%s\n%s\n%s\n' "$map" "$SENTINEL" "$1" |
    awk -F"$TAB" -v now="$now" -v sentinel="$SENTINEL" '
      BEGIN { OFS = FS }
      !past {
        if ($0 == sentinel) { past = 1; next }
        if (NF >= 2) { status[$1] = $2; reason[$1] = $3 }
        next
      }
      {
        sid = $10
        if ($1 != "" || sid == "" || !(sid in status)) { print; next }
        s = status[sid]
        # An unrecognised status is left alone rather than guessed at. The
        # vocabulary belongs to the CLI, not to this script, and a value never
        # seen before must not be mapped onto a glyph by accident. (No
        # apostrophes in this program: it is one long single-quoted shell
        # string.)
        #
        # "shell" is in the set because it is NOT an unknown: the CLI derives it
        # as status === "idle" and the user at a shell, so it is a flavour of
        # idle, which already means not blocked. Read out of the installed
        # bundle rather than inferred from behaviour. Left out, it was the one
        # value that could strand a pane red forever -- no hook reports the
        # transition into a shell either, so this poller is the only thing that
        # could ever clear it, and it declined to.
        if (s != "waiting" && s != "busy" && s != "idle" && s != "shell") { print; next }
        # Only the blocked/not-blocked disagreement is acted on. When the two
        # agree, the hook data is kept whole: its note names the tool and its
        # per-actor listing names which subagent is blocked, and the CLI knows
        # neither.
        # Every state that prints 🛑 counts as blocked here, which is the same
        # rule ctrl-o is offered by. Leaving one out leaves exactly that state
        # stuck red, and it is the kind of gap a merge opens quietly: this one
        # arrived with needs_input, after the correction was written.
        hook_blocked = ($6 == "asking" || $6 == "waiting" || $6 == "needs_input")
        cli_blocked = (s == "waiting")
        if (hook_blocked == cli_blocked) { print; next }
        if (cli_blocked) {
          $6 = "waiting"; $8 = reason[sid]
        } else {
          $6 = (s == "busy") ? "busy" : "stalled"; $8 = ""
        }
        # The age becomes "since this was last confirmed", not "since the state
        # was entered": the CLI publishes no timestamp for its status, and
        # keeping the hooks one would date a state it disagrees with.
        $7 = now
        # The per-actor listing is derived from the same records that were just
        # contradicted, so rendering it would put the stale rows back. The pane
        # falls back to this one corrected row.
        $9 = ""
        print
      }
    '
}

# render_list <rows> — the finished, sorted list fzf reads. A function for the
# same reason collect_rows is one: the picker renders again on every refresh.
render_list() {
  printf '%s\n' "$1" | awk -F"$TAB" -v now="$now" -v rsep="$RS" -v usep="$US" '
    function age(s,   d) {
      if (s == "") return "-"
      d = now - s
      if (d < 60)   return d "s"
      if (d < 3600) return int(d / 60) "m"
      return int(d / 3600) "h"
    }
    # One line per actor. The key stays the pane, because a subagent has no pane
    # of its own — jumping to it means jumping to the conversation running it —
    # so the rows differ only in what they say, which is the point: the blocked
    # subagent sorts to the top on its own instead of hiding behind whichever
    # actor happened to write the pane options last.
    function emit(st, since, note, label,   rank, glyph, where, name) {
      # asking/waiting share rank 0: both mean a dialog is open and nothing moves
      # until it is answered, and which one is more urgent is not for this script
      # to guess. needs_input follows them rather than joining them: it is also
      # blocked on the human, but somewhere you have to go rather than in a
      # dialog this picker can answer. Everything else lands in the last rank,
      # where the age sort below floats the longest-untouched one up on its own.
      rank = (st == "asking" || st == "waiting") ? 0 \
           : (st == "needs_input") ? 1 \
           : (st == "busy") ? 2 : 3

      # Same per-glyph spacing rule as agent-state.sh: the emoji ones are
      # already two cells wide, the narrow ▶ is padded to two, so the
      # columns after the glyph line up across rows.
      glyph = (st == "asking" || st == "waiting" || st == "needs_input") \
              ? "🛑" \
            : (st == "busy") ? "▶ " : "🟢"
      where = ($1 == "") ? "local" : $1
      # The label is bracketed with ASCII, not set off with a nicer glyph:
      # printf pads by bytes, so a multibyte separator in a %-28s column shifts
      # everything after it on exactly the rows that carry one.
      name = (label == "") ? $5 : $5 " [" label "]"
      # The state travels in the key too: ctrl-o is only offered for a session
      # that is actually blocked on the human, and re-deriving that from the
      # glyph after the fact would be reading the rendering back. The state here
      # belongs to the actor on this row, not to the pane as a whole, so the row
      # only offers to answer the dialog it is actually reporting. (No
      # apostrophes in this program: it is one long single-quoted shell string,
      # and one would end it — the same trap session-review documents for jq.)
      printf "%s\t%s\t%s|%s|%s|%s\t%s %4s  %-12s %-28s %s\n", \
        rank, since, $1, $3, $4, st, glyph, age(since), where, name, note
    }
    $6 == "" { next }                                   # no agent in this pane
    $2 ~ /^_/ { next }                                  # _popup_ / _tig_ / _fzf_nvim_ sessions
    {
      n = ($9 == "") ? 0 : split($9, records, rsep)
      if (n == 0) {
        emit($6, $7, $8, "")                            # older hook: aggregate only
        next
      }
      for (i = 1; i <= n; i++) {
        if (records[i] == "") continue                  # trailing separator
        split(records[i], f, usep)
        # An empty state is not an actor — the same rule as $6 above, which is
        # what keeps a pane with no agent out of the list. A record can arrive
        # that way if the option was ever written or truncated by something
        # other than the hook, and a state-less row renders as a plausible
        # grey circle with no age, which is worse than not being there.
        #
        # An *unrecognised* state is deliberately still rendered, as the last
        # glyph in emit(). Dropping it would mean an older copy of this script
        # hides an agent whose state a newer hook has just learned to publish,
        # and a hidden blocked session is the one failure this list exists to
        # prevent. A wrong glyph on a visible row is the cheaper mistake.
        if (f[1] == "") continue
        emit(f[1], f[2], f[4], f[3])
      }
    }
  ' | sort -t"$TAB" -k1,1n -k2,2n | cut -f3-
}

# --rows — the refresh half of the picker, re-entered by fzf every REFRESH
# seconds. It is a separate mode rather than a flag on the main path because the
# first list must not wait for the CLI: the popup is already on screen, so the
# picker draws from the pane options at once and the corrected list replaces it
# a moment later.
if [ "${1:-}" = "--rows" ]; then
  render_list "$(correct_rows "$(collect_rows)")"
  exit 0
fi

# --- write the correction back onto the panes (--sync) ------------------------

# --rows fixes the picker and nothing else. The WezTerm tab glyph is read
# straight out of @claude_glyph by set-titles-string, so until something writes
# that option a tab stays red for the whole of an approved command and keeps
# whatever glyph it had through an interrupt. --sync is that something, run from
# launchd.
#
# It is a MODE OF THIS SCRIPT rather than a script of its own for one reason:
# the rule deciding what to correct would otherwise exist twice, and the two
# copies would drift — which is exactly how `needs_input` came to be missing
# from the one in correct_rows.
#
# The correction is applied by calling the hook, never by setting the options
# here. publish() skips its tmux calls while the records still match what it
# last published, so an option written behind its back would make the next
# genuine transition a no-op — see agent-state.md, which is also where the rules
# about which actors a correction reaches live.
#
# Named by its installed path, with no override to point it elsewhere: the test
# supplies a $HOME instead, which keeps this script free of a seam that exists
# only for the test.
hook=$HOME/.claude/hooks/agent-state.sh

sync_panes() {
  local rows corrected sock changes pane state note

  rows=$(collect_rows local)
  # The guard that makes a 5s timer affordable: `claude agents --json` is the
  # only expensive part, and with no pane bound to a session there is nothing to
  # ask it about. One awk over rows already in hand, and on a machine with no
  # Claude running under tmux that is the entire cost of a tick.
  printf '%s\n' "$rows" | awk -F"$TAB" '$10 != "" { found = 1 } END { exit !found }' || return 0
  [ -x "$hook" ] || return 0
  sock=$(tmux display-message -p '#{socket_path}' 2>/dev/null) || return 0
  [ -n "$sock" ] || return 0

  corrected=$(correct_rows "$rows")
  # Only the rows the correction actually changed. Comparing the two listings is
  # what keeps a tick free of writes when nothing is wrong: correct_rows prints
  # every row either way, and re-applying an unchanged one would set four
  # options and force a redraw on every pane, every tick, forever.
  changes=$(printf '%s\n%s\n%s\n' "$rows" "$SENTINEL" "$corrected" |
    awk -F"$TAB" -v sentinel="$SENTINEL" '
      BEGIN { OFS = FS }
      !past { if ($0 == sentinel) { past = 1; next } before[++n] = $0; next }
      { i++; if ($0 == before[i]) next; print $4, $6, $8 }
    ')
  [ -n "$changes" ] || return 0

  # $TMUX is constructed rather than inherited: under launchd there is none, and
  # the hook reads only its first field (the socket) to key its records. The
  # pane is the hook's other half of that key, and is the whole reason
  # @claude_session_id exists — it is what turned a sessionId into this pane.
  while IFS="$TAB" read -r pane state note; do
    [ -n "$pane" ] || continue
    TMUX="$sock,0,0" TMUX_PANE="$pane" "$hook" correct "$state" "$note" </dev/null || true
  done <<<"$changes"
}

if [ "${1:-}" = "--sync" ]; then
  sync_panes
  exit 0
fi

rows=$(collect_rows)

# prefix + A acts on one row without showing you any of them, so it is the one
# path that cannot afford a stale state: it would open a session that has
# already been answered, or say "nothing is waiting on you" while a dialog whose
# 🛑 is still 6s away sits open. It pays the CLI up front for that reason, where
# the picker defers it to the first refresh — 140ms before a popup opens is not
# noticeable, and 140ms before the picker paints is the whole latency budget.
if [ -n "$answer_client" ]; then
  rows=$(correct_rows "$rows")
fi

list=$(render_list "$rows")

# --- answer the first red one (prefix + A) ------------------------------------

# Placed before the empty-list branch below, which holds a popup open until a
# key is pressed: there is no popup here, so that would hang a backgrounded
# run-shell job forever with nothing on screen to explain it.
#
# The row is chosen by the same rule ctrl-o is offered by — a local row whose
# state is one of the three the 🛑 glyph covers — read off the hidden key field
# rather than re-derived, so the two keys cannot drift apart. `sort` has already
# put the longest-blocked one first, so "the first match" is the pick.
if [ -n "$answer_client" ]; then
  outer_client=$answer_client

  target=$(printf '%s\n' "$list" |
    awk -F"$TAB" '$1 ~ /^\|/ && $1 ~ /\|(asking|waiting|needs_input)$/ { print $1; exit }')

  if [ -z "$target" ]; then
    # Three different silences, told apart: nothing running, something red that
    # this key cannot reach, and everything running fine. A key that does
    # nothing and says nothing is indistinguishable from tmux having dropped it.
    if [ -z "$list" ]; then
      msg "no Claude agents running"
    elif printf '%s\n' "$list" |
      awk -F"$TAB" '$1 ~ /\|(asking|waiting|needs_input)$/ { found = 1 } END { exit !found }'; then
      msg "the blocked agent is remote — C-q a to see it"
    else
      msg "nothing is waiting on you"
    fi
    exit 0
  fi

  IFS='|' read -r _ window_id pane_id _ <<<"$target"

  # Same hop the picker's ctrl-o makes: run-shell -b so this process returns
  # rather than holding the popup open from inside a tmux job.
  tmux run-shell -b "$view open $outer_client $window_id $pane_id"
  exit 0
fi

if [ -z "$list" ]; then
  # Exiting straight away closes the popup the instant it opens, which reads as
  # a crash rather than as "nothing to show". Hold it until a key is pressed.
  # Guarded on a tty so a non-interactive run (or a pipe) still returns.
  printf '\n  no Claude agents running\n\n  press any key to close\n'
  if [ -t 0 ]; then
    read -r -n 1 -s || true
  fi
  exit 0
fi

# fzf merges the caller's FZF_DEFAULT_OPTS *ahead* of the flags below, and the
# global one (.zshenv) is tuned for picking files: --accept-nth=-1 makes fzf
# print only the last field, silently discarding the key this script parses;
# --nth=-1 restricts matching to it; and --preview runs bat over what it assumes
# is a path, which errors on every row here. None of that survives contact with a
# key/display list, and the first one fails *quietly* — the picker looks fine and
# the jump just does nothing. So the environment is replaced, not extended.
export FZF_DEFAULT_OPTS=
unset FZF_DEFAULT_OPTS_FILE

readonly HINT='enter: jump to the tab   ctrl-o: answer a blocked one here'

# ctrl-o is refused per row, inside fzf, rather than after the picker has
# closed. Refusing afterwards can only close the popup and print to the status
# line, which is itself something happening — and what is wanted from a key that
# does not apply is a warning and nothing else. So the binding decides from the
# row's hidden key field (host|window|pane|state) and, when it does not apply,
# only rewrites the header. `focus` puts the hint back as soon as the cursor
# moves, so the warning cannot strand you without it.
#
# `print(...)+accept` reproduces exactly what --expect used to emit — the key on
# its own first line, empty for enter — so the parsing below is unchanged. That
# is the documented idiom for it (see the --bind examples in fzf(1)); --expect
# cannot be used alongside a --bind on the same key, since the binding replaces
# it and every ctrl-o would then read as a plain enter, i.e. as a jump.
#
# enter is refused per row the same way, but its answer cannot be read off the
# row: whether a WezTerm tab exists for that window takes tmux and possibly
# wezterm to work out. So it re-enters this script as --jump-check, which prints
# the fzf actions to run. Paid only when enter is pressed, and never on the
# latency path before the picker.
#
# The list refreshes itself while it is open, which matters more here than it
# looks: 🛑 arrives 6s after the dialog does, so a picker opened to find out who
# is blocked could be drawn just before the answer it exists to give.
#
# `start` corrects the first list as soon as the picker is up. `load` fires
# again after every reload, which is what turns it into a loop: fzf has no timer
# of its own, so the wait is the `sleep` at the head of the reload command.
#
# **The sleep must sit inside the reload command, never in a `transform`.** A
# transform runs synchronously — fzf waits for it — so a version of this that
# slept there froze the whole picker for REFRESH seconds at a time, swallowing
# keystrokes. It looked like a jump that did nothing, and the pty cases in
# tmux-agents.test.sh are what caught it.
#
# reload-sync rather than reload, so the list is replaced only once the new one
# is complete and never blinks empty on a slow tick. The cursor needs no help:
# measured against fzf 0.74, it stays on the same row index across a
# reload-sync, which is why there is no pos() dance here.
#
# The shell-side checks after the picker are kept as well. They are what a
# headless test can reach, and they are the ones that still have to hold if a
# future fzf changes what a transform may return.
picked=$(
  printf '%s\n' "$list" |
    fzf --delimiter="$TAB" --with-nth=2.. \
      --no-multi --no-sort --reverse \
      --prompt='agent> ' \
      --header="$HINT" \
      --bind="focus:change-header($HINT)" \
      --bind="start:reload-sync($self --rows)" \
      --bind="load:reload-sync(sleep $REFRESH; $self --rows)" \
      --bind="enter:transform:$self --jump-check {1}" \
      --bind='ctrl-o:transform:case {1} in
                "|"*asking | "|"*waiting | "|"*needs_input) echo "print(ctrl-o)+accept" ;;
                *asking | *waiting | *needs_input) echo "change-header(ctrl-o: a remote agent cannot be answered here yet)" ;;
                *) echo "change-header(ctrl-o: that session is not waiting on you)" ;;
              esac'
) || exit 0

# The key that closed the picker is on its own first line, empty for enter.
key=${picked%%$'\n'*}
selection=${picked#*$'\n'}

# --- resolve the pick ---------------------------------------------------------

# $TMUX is "socket,pid,session-id"; the client attached to that session is the
# one that opened this popup. `head -1` because a session can carry more than one
# client, and any of them is a reasonable target for a status message.
if [ -n "${TMUX:-}" ]; then
  outer_client=$(tmux list-clients -F '#{client_name}' -t "\$${TMUX##*,}" 2>/dev/null | head -1) || true
fi

IFS='|' read -r host window_id pane_id state <<<"${selection%%$'\t'*}"

# --- answer here (ctrl-o) ----------------------------------------------------

# Refusing means doing nothing at all -- never falling back to the jump. The two
# keys mean different things, and a ctrl-o that silently moved you to another
# tab is worse than one that does not fire: you asked to stay where you are.
# Each refusal says why on the status line and stops there.
if [ "$key" = "ctrl-o" ]; then
  case "$state" in
    asking | waiting | needs_input) ;;
    *)
      # Only a session blocked on the human has anything to answer. For a busy
      # or a finished one there is nothing here to act on.
      msg "that session is not waiting on you"
      exit 0
      ;;
  esac

  if [ -n "$host" ]; then
    # A remote agent lives in the remote tmux, so the mirror would have to be a
    # nested `ssh -t <host> tmux attach`. That is reachable from here — the
    # listing already queries that host — but nothing on this machine exercises
    # it, so it is left out rather than shipped untested.
    msg "answering a remote agent here is not supported yet"
    exit 0
  fi

  # No client means nowhere to put a popup, and no status line to say so on.
  [ -n "$outer_client" ] || exit 0

  tmux run-shell -b "$view open $outer_client $window_id $pane_id"
  exit 0
fi

# --- jump --------------------------------------------------------------------

resolve_jump "${selection%%$'\t'*}"

if [ -n "$rj_reason" ]; then
  # Belt and braces: the picker refuses these rows before accepting (the enter
  # binding asks the same function through --jump-check), so this is only
  # reachable if that binding is gone. It must still not fall back to anything.
  msg "$rj_reason"
  exit 0
fi

# Only now: the pane is made active because the tab is about to be raised with
# the agent in front. Refusing above must leave everything as it was.
tmux select-pane -t "$rj_pane" 2>/dev/null || true

wezterm cli --no-auto-start activate-tab --tab-id "$rj_tab" 2>/dev/null || true

# activate-tab only re-points the tab bar of the window that owns the tab; it
# leaves OS focus where it was, so a jump across WezTerm windows raised nothing
# and looked like a no-op. There is no CLI verb for it (checked on 20240203) —
# window:focus() is Lua-only — so poke the user-var handler in wezterm.lua by
# writing OSC 1337 SetUserVar to the target pane's own tty: WezTerm attributes
# it to that pane and hands the handler its window. "MQ==" is base64 "1"; the
# value is ignored, only the event matters, and re-setting the same value does
# fire again. Harmless when the target is already focused, and inert on any
# terminal that is not WezTerm (unknown OSC, discarded).
printf '\033]1337;SetUserVar=focus_window=MQ==\007' >"$rj_tty" 2>/dev/null || true

# Plain `[ ... ] && msg` would make a local jump exit non-zero under set -e.
if [ -n "$rj_remote_note" ]; then
  msg "jumped to$rj_remote_note"
fi

exit 0
