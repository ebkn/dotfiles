#!/bin/bash
#
# test-in-docker [suite...]
#
# Run test suites inside a container built to match the CI runner, through
# bin/test -- so they run in parallel, with its timeout, time table and
# verdict. With no arguments, runs the tmux suites: those bin/test skips on a
# laptop, which must never run on the host.
# TEST_JOBS and TEST_TIMEOUT are passed through to bin/test.
# TEST_DOCKER_PLATFORM=linux/amd64 runs on the runner's architecture instead of
# the host's -- under emulation on Apple silicon, ~60 s for the tmux suites
# against ~8 s.
# See bin/test-in-docker.md.

set -eo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
image=dotfiles-test

if [ "$#" -gt 0 ]; then
  suites=("$@")
else
  # bin/test's own answer for a laptop -- the suites it skips as tmux suites --
  # rather than a second copy of the regex that finds them: two copies could
  # drift, and the suites one dropped would then run nowhere outside CI.
  # Asked as a laptop whatever this runs on (CI, another container), so the
  # answer is the same everywhere. A command substitution with its status
  # checked, not a process substitution: a failed listing must not become
  # "ran nothing, all green".
  if ! listing=$(cd "$repo" && env -u GITHUB_ACTIONS TEST_CONTAINER_MARK=/nonexistent bin/test --list); then
    echo "test-in-docker: bin/test --list failed" >&2
    exit 1
  fi
  suites=()
  while IFS= read -r line; do
    case "$line" in
      'skip '*'  (a tmux suite: '*)
        f=${line#skip }
        suites+=("${f%%  (*}")
        ;;
    esac
  done <<<"$listing"
  if [ "${#suites[@]}" -eq 0 ]; then
    echo "test-in-docker: bin/test --list named no tmux suites" >&2
    exit 1
  fi
fi

# The host's platform unless asked otherwise, and the same one for the build
# and the run: the image is one tag, which the build re-points either way.
platform=()
if [ -n "${TEST_DOCKER_PLATFORM:-}" ]; then
  platform=(--platform "$TEST_DOCKER_PLATFORM")
fi

# After the listing, so a refused listing fails before the image build. Built
# from stdin, so no build context is sent. Cached after the first run;
# the tmux compile only repeats when the Dockerfile changes.
docker build --quiet ${platform[@]+"${platform[@]}"} -t "$image" - \
  <"$repo/bin/test-in-docker.Dockerfile" >/dev/null

# Read-only: a suite writes to its own mktemp dir, never to the checkout. No
# -t, so TERM stays unset as it is on the runner. -e without a value passes a
# variable only when it is set here.
docker run --rm ${platform[@]+"${platform[@]}"} -v "$repo:/work:ro" \
  -e TEST_JOBS -e TEST_TIMEOUT "$image" bin/test "${suites[@]}"
