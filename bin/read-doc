#!/usr/bin/env bash
#
# read-doc — typeset a document as HTML and open it in the browser.
#
# The whole point of this script is read-doc/style.css: a terminal is a grid of
# equal-size cells, so no pager can use a proportional face, and long-form
# Japanese is much easier to read in one. pandoc is just the adapter -- kept
# over the far smaller cmark-gfm because it highlights server-side, so the
# colours survive with scripting off. Do not turn this into a terminal pager,
# and do not "optimise" to cmark-gfm without solving highlighting.
#
# The page loads nothing and works offline. The input is UNTRUSTED (documents
# arrive over ssh or forwarded from a remote pane), so pandoc runs under
# --sandbox and the page carries a Content-Security-Policy <meta>. The
# consequences of both -- why style.css is inlined through header-includes
# rather than --css, why a document-relative image is inlined here rather than
# fetched by pandoc, and the gap 'unsafe-inline' leaves open -- are in
# bin/read-doc.md.
#
# Three ways to run it, and why there are three:
#   local      read-doc FILE            renders here, opens the browser here
#   pull       read-doc HOST:FILE       fetches over ssh, renders and opens here
#   forward    read-doc FILE  (in ssh)  ships the SOURCE to the terminal's own
#                                       machine, which renders and opens it
#
#   `forward` exists because inside an ssh session `open` would launch a browser
#   on the machine you are logged in to, invisible to you. The SOURCE crosses
#   the wire, not the HTML, so the remote needs no pandoc and style.css stays a
#   single source of truth. Its three constraints are in bin/read-doc.md.
#
# Usage:
#   read-doc README.md            # render and open in the default browser
#   read-doc notes.txt            # non-Markdown prose is read as Markdown
#   read-doc main.go              # source files are fenced, so they highlight
#   read-doc mbp2026:notes/a.md   # pull over ssh, render here
#   read-doc --print README.md    # write the HTML to stdout, open nothing
#   read-doc --here README.md     # in an ssh session, open on THIS machine
#   ssh host cat doc.md | read-doc    # stdin
#
# Exit status: 0 on success, 2 on tool or usage failure.
#
# Env:
#   READ_DOC_BROWSER   open(1) -a target, e.g. "Safari" (default: system default)
#   READ_DOC_MAX_BYTES forwarding size cap (default 262144); see the note below
#   READ_DOC_IMAGE_MAX_BYTES  per-image inlining cap (default 4194304)
set -uo pipefail

SELF_DIR="$(dirname "$(readlink -f "$0")")"
STYLE="${SELF_DIR}/../read-doc/style.css"
AFTER="${SELF_DIR}/../read-doc/after-body.html"

usage() {
  printf 'usage: read-doc [--print|--here] <file>\n' >&2
  printf '       read-doc [--print|--here] <host>:<file>\n' >&2
  printf '       <something> | read-doc [--print|--here] [--name NAME]\n' >&2
}

print_only=0
force_here=0
name=""
src=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    -p | --print)
      print_only=1
      shift
      ;;
    --here)
      force_here=1
      shift
      ;;
    --name)
      name="${2-}"
      [ -n "${name}" ] || {
        usage
        exit 2
      }
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      printf 'read-doc: unknown option %s\n' "$1" >&2
      usage
      exit 2
      ;;
    *)
      [ -z "${src}" ] || {
        printf 'read-doc: one file at a time\n' >&2
        exit 2
      }
      src="$1"
      shift
      ;;
  esac
done

if [ -z "${src}" ] && [ -t 0 ]; then
  usage
  exit 2
fi

# --- pull: HOST:FILE ---------------------------------------------------------
#
# Only treated as remote when no local file of that name exists, so a literal
# path containing a colon still wins. The host pattern is deliberately narrow
# (ssh_config aliases and hostnames) to keep "./a:b" and "C:/x" out of it.
fetched=""
if [ -n "${src}" ] && [ ! -e "${src}" ] && printf '%s' "${src}" | grep -qE '^[A-Za-z0-9_][A-Za-z0-9_.-]*:'; then
  remote_host="${src%%:*}"
  remote_path="${src#*:}"
  [ -n "${name}" ] || name="$(basename -- "${remote_path}")"

  # Quote for the remote shell, but leave a leading ~ unquoted so that
  # `read-doc host:~/notes/a.md` expands there rather than looking for a
  # directory literally named "~".
  # SC2088 is the point, not a bug: the tilde must reach the REMOTE shell
  # unexpanded, so it deliberately stays outside the quotes and is not $HOME
  # (which would be this machine's home, not the far end's).
  # shellcheck disable=SC2088
  case "${remote_path}" in
    '~/'*) remote_arg="~/'$(printf '%s' "${remote_path#\~/}" | sed "s/'/'\\\\''/g")'" ;;
    *) remote_arg="'$(printf '%s' "${remote_path}" | sed "s/'/'\\\\''/g")'" ;;
  esac

  fetched="$(mktemp -t read-doc)" || exit 2
  trap 'rm -f "${fetched}"' EXIT
  # SC2029: client-side expansion is intended — remote_arg was quoted above
  # precisely so that this side decides what the remote shell receives.
  # shellcheck disable=SC2029
  if ! ssh "${remote_host}" "cat -- ${remote_arg}" >"${fetched}"; then
    printf 'read-doc: failed to fetch %s\n' "${src}" >&2
    exit 2
  fi
  src="${fetched}"
fi

if [ -n "${src}" ] && [ ! -r "${src}" ]; then
  printf 'read-doc: cannot read %s\n' "${src}" >&2
  exit 2
fi

base="${name:-$([ -n "${src}" ] && basename -- "${src}" || echo "stdin")}"
title="${base%.*}"

# --- forward: hand the source to the terminal's own machine -------------------
#
# In an ssh session `open` would launch a browser on the far end, where nobody
# is looking — which is the whole bug this branch exists to fix.
if [ -n "${SSH_CONNECTION:-}" ] && [ "${print_only}" -eq 0 ] && [ "${force_here}" -eq 0 ]; then
  if [ -n "${src}" ]; then payload_src="$(cat -- "${src}")"; else payload_src="$(cat)"; fi

  # The name travels with the body so the receiving side keeps the extension,
  # which is what drives language detection and the page title.
  payload="$(printf '%s\n%s' "${base}" "${payload_src}" | base64 | tr -d '\n')"

  # Neither WezTerm nor tmux documents a maximum length for these sequences,
  # and tmux has a history of truncating long passthrough (tmux#1502). An
  # undocumented ceiling that corrupts silently is worse than a refusal, so
  # cap it and say what to run instead. Raise READ_DOC_MAX_BYTES if measurement
  # on your own path says you can.
  #
  # Measured on the ENCODED payload, which is what actually reaches the
  # terminal, and because ${#var} counts characters rather than bytes: a
  # Japanese document is ~3 bytes per character, so checking the source that
  # way under-counts by a third and let a 308KB file straight through.
  # base64 is ASCII, so here the two agree.
  max="${READ_DOC_MAX_BYTES:-262144}"
  if [ "${#payload}" -gt "${max}" ]; then
    printf 'read-doc: %s encodes to %s bytes, over the %s-byte forwarding cap.\n' \
      "${base}" "${#payload}" "${max}" >&2
    printf 'read-doc: run this from the terminal'"'"'s own machine instead\n' >&2
    # A pulled document must be advised by its ORIGINAL location: ${src} is a
    # local temp path by then, which would be useless on the other machine.
    if [ -n "${fetched}" ]; then
      printf 'read-doc: (that host already holds it):\n  read-doc %s:%s\n' \
        "${remote_host}" "${remote_path}" >&2
    else
      # The host below is only what this machine calls itself. Nothing here can
      # know the alias the *client* resolves it by — that lives in the other
      # end's ssh_config — so it is a hint to correct, not a command to paste.
      abs="${src}"
      case "${abs}" in
        /* | "") ;;
        *) abs="$(cd "$(dirname -- "${src}")" && pwd)/$(basename -- "${src}")" ;;
      esac
      printf 'read-doc: (adjust the host to whatever your ssh config calls it):\n' >&2
      printf '  read-doc %s:%s\n' "$(hostname -s)" "${abs:-<file>}" >&2
    fi
    exit 2
  fi

  esc=$(printf '\033')
  bel=$(printf '\007')
  seq="${esc}]1337;SetUserVar=read_doc=${payload}${bel}"

  # Each tmux between here and the terminal emulator strips exactly one DCS
  # passthrough wrapper, and this side cannot know how many there are: $TMUX
  # reveals the local one, never the one running next to the terminal. Guessing
  # wrong fails silently, so every plausible depth is emitted. Exactly one can
  # survive — a wrapper that arrives one layer short is eaten by the last tmux,
  # and one that arrives too deep reaches WezTerm as an unknown DCS, which it
  # ignores. Requires `allow-passthrough on` (already set in .tmux.conf).
  emit="${seq}"
  for _ in 1 2; do
    seq="${esc}Ptmux;${seq//${esc}/${esc}${esc}}${esc}\\"
    emit="${emit}${seq}"
  done

  # Straight to the terminal, not stdout: this must not land in a pipe or a
  # redirect when read-doc is used inside one. Attempt the write rather than
  # testing -w first — /dev/tty passes a permission test even where there is
  # no controlling terminal, then fails at write time with ENXIO, which made
  # an earlier version exit 0 having emitted nothing at all.
  # The braces matter: a bare `cmd > /dev/tty 2>/dev/null` still lets the
  # shell print its own "Device not configured" to stderr, because that
  # message is emitted by the redirect, not by the command.
  if ! { printf '%s' "${emit}" >/dev/tty; } 2>/dev/null; then
    printf '%s' "${emit}"
  fi

  # No URL to print here: the receiving machine chooses where the rendered
  # page lands and there is no channel back to learn it. Re-running this
  # command re-renders and re-opens it, which is cheaper than plumbing one.
  printf 'read-doc: sent %s to the terminal'"'"'s machine\n' "${base}" >&2
  exit 0
fi

# --- render ------------------------------------------------------------------

if [ ! -f "${STYLE}" ]; then
  printf 'read-doc: stylesheet not found at %s\n' "${STYLE}" >&2
  exit 2
fi

if [ ! -f "${AFTER}" ]; then
  printf 'read-doc: after-body include not found at %s\n' "${AFTER}" >&2
  exit 2
fi

if ! command -v pandoc >/dev/null 2>&1; then
  printf 'read-doc: pandoc not found in PATH (brew install pandoc)\n' >&2
  exit 2
fi

# Which extensions are prose and which are code. A Markdown reader run over
# source code mangles it — `#` becomes a heading, `*` becomes emphasis — so
# code is fenced first and handed to the same reader as a single block. That
# keeps one rendering path instead of two, and gets highlighting for free.
lang=""
case "${base}" in
  *.md | *.markdown | *.mdown | *.mkd | *.mdx) lang="" ;;
  *.txt | *.text | *.rst | *.org | "") lang="" ;;
  Dockerfile | Dockerfile.* | *.dockerfile) lang="dockerfile" ;;
  Makefile | makefile | GNUmakefile | *.mk) lang="makefile" ;;
  *.zsh | .zshrc | .zshenv | .zprofile) lang="zsh" ;;
  *.sh | *.bash | .bashrc | .profile) lang="bash" ;;
  *.go) lang="go" ;;
  *.ts | *.tsx) lang="typescript" ;;
  *.js | *.jsx | *.mjs | *.cjs) lang="javascript" ;;
  *.py) lang="python" ;;
  *.rb) lang="ruby" ;;
  *.rs) lang="rust" ;;
  *.swift) lang="swift" ;;
  *.lua) lang="lua" ;;
  *.c | *.h) lang="c" ;;
  *.cc | *.cpp | *.hpp | *.cxx) lang="cpp" ;;
  *.java) lang="java" ;;
  *.php) lang="php" ;;
  *.json) lang="json" ;;
  *.yml | *.yaml) lang="yaml" ;;
  *.toml) lang="toml" ;;
  *.ini | *.conf | *.cfg) lang="ini" ;;
  *.sql) lang="sql" ;;
  *.css) lang="css" ;;
  *.html | *.htm) lang="html" ;;
  *.xml) lang="xml" ;;
  *.diff | *.patch) lang="diff" ;;
  # Unknown extensions fall through as prose: guessing "code" and fencing a
  # document is a worse failure than guessing "prose" and rendering source
  # without colour, because the first hides the text behind a scrollbar.
  *) lang="" ;;
esac

# Extensionless executables are the norm here — bin/relink, bin/lint-shell,
# tmux-restore-tabs — and matching on name alone silently renders them as
# prose, which is how this was first written and how it first went wrong.
# bin/lint-shell already discovers its own targets by shebang; do the same.
if [ -z "${lang}" ] && [ -n "${src}" ] && [ -f "${src}" ]; then
  case "$(head -n 1 -- "${src}" 2>/dev/null)" in
    '#!'*zsh*) lang="zsh" ;;
    '#!'*bash* | '#!'*/sh | '#!'*/sh[[:space:]]*) lang="bash" ;;
    '#!'*python*) lang="python" ;;
    '#!'*ruby*) lang="ruby" ;;
    '#!'*node*) lang="javascript" ;;
    '#!'*perl*) lang="perl" ;;
  esac
fi

# The policy the rendered page carries. `default-src 'none'` is the part that
# matters: whatever raw HTML a document smuggled through the reader cannot
# fetch, XHR or open a socket, so nothing about this machine leaks outward. The
# two 'unsafe-inline' relaxations are what our own output needs (pandoc's
# highlighting rules, and read-doc/after-body.html).
#
# Known gap: 'unsafe-inline' also permits a script the *document* brought with
# it, and CSP cannot stop one navigating the top-level page here -- so this buys
# silence, not immobility. See bin/read-doc.md for how to close it.
CSP="default-src 'none'; img-src data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'"

# header-includes rather than --css: --sandbox blocks the writer-side fetch
# --embed-resources used to do, so a <link> would be left pointing at a path
# CSP then refuses to load. Reading the file here keeps the theme inline.
# The placement is the same one --embed-resources gave us and is load-bearing:
# the html5 template emits $styles.html()$ (pandoc's highlighting rules) before
# $for(header-includes)$, so ours come last and win. Reordering the template
# would break the theme with no error.
header_includes="$(
  printf '<meta http-equiv="Content-Security-Policy" content="%s">\n' "${CSP}"
  printf '<style>\n'
  cat -- "${STYLE}"
  printf '\n</style>\n'
)"

render() {
  # -V document-css= empties the template's `$if(document-css)$` guard, which
  # drops pandoc's built-in page styling while keeping its highlighting rules.
  # An empty value is required: the guard tests for non-emptiness, so the
  # documented `document-css=false` is a non-empty string and reads as true.
  #
  # tex_math_dollars and tex_math_gfm are both on by default in the gfm
  # reader, which makes `$` open inline maths. In documents about software
  # that is nearly always wrong: ${VAR} and $PATH are far commoner than
  # LaTeX, and a mismatched pair silently swallows the text between them.
  #
  # pagetitle rather than title: setting `title` also makes the template emit
  # a <h1 class="title"> into the body, which duplicates the document's own
  # first heading. pagetitle fills the browser tab and nothing else.
  #
  # --sandbox limits reader/writer IO to the files named on the command line.
  # --include-after-body is read by the CLI itself and so still works; the
  # stylesheet is not, which is why it arrives via header-includes above.
  pandoc \
    --sandbox \
    --from=gfm-tex_math_dollars-tex_math_gfm \
    --to=html5 \
    --standalone \
    --syntax-highlighting=default \
    --variable=document-css= \
    --variable=header-includes="${header_includes}" \
    --include-after-body="${AFTER}" \
    --metadata=pagetitle="${title}"
}

feed() {
  if [ -n "${lang}" ]; then
    # A run of eight tildes: long enough that no realistic source file closes
    # the fence early, and tildes rather than backticks because backtick runs
    # do occur in shell and Markdown-adjacent sources.
    printf '~~~~~~~~%s\n' "${lang}"
    if [ -n "${src}" ]; then cat -- "${src}"; else cat; fi
    printf '\n~~~~~~~~\n'
  elif [ -n "${src}" ]; then
    cat -- "${src}"
  else
    cat
  fi
}

# --- images: inline the document's own, as data: URIs -------------------------
#
# `--sandbox` refuses to fetch a referenced image (it is a writer-side read) and
# the CSP allows `img-src data:` only, so `![](./images/a.svg)` arrives as a
# broken box. Both of those are wanted for a document that came from elsewhere,
# so the embedding happens here instead, on the rendered HTML, and only for a
# document this machine named on the command line itself: stdin and `HOST:FILE`
# are skipped, since a pulled document's neighbours never crossed the wire and
# its temp path would resolve them into $TMPDIR.
#
# Confined to the document's own directory tree. Not because reading wider would
# fail, but because `script-src 'unsafe-inline'` already lets a document smuggle
# a script through the raw-HTML passthrough and CSP has no directive here
# against navigating the top level (see bin/read-doc.md). Embedding any path the
# document asks for would hand such a script `../../.ssh/id_rsa` as base64 in
# the DOM to carry out in a URL; confining it means the secret has to be sitting
# beside the document already. A legitimate `../images/a.svg` is refused on
# stderr rather than silently, so it reads as "move it", not as "this is broken".
image_mime() {
  case "$1" in
    *.svg | *.SVG) printf 'image/svg+xml' ;;
    *.png | *.PNG) printf 'image/png' ;;
    *.jpg | *.jpeg | *.JPG | *.JPEG) printf 'image/jpeg' ;;
    *.gif | *.GIF) printf 'image/gif' ;;
    *.webp | *.WEBP) printf 'image/webp' ;;
    *.avif | *.AVIF) printf 'image/avif' ;;
    # No default: an unknown extension stays a broken reference rather than
    # being guessed at, because a wrong MIME renders as nothing, with no message.
    *) return 1 ;;
  esac
}

# $1 rendered HTML (edited in place), $2 directory the document was read from
embed_images() {
  # Declared local: `max` is also the forwarding cap above, and that branch
  # only happens to exit before reaching here.
  local html root max map ref skip head path dir mime bytes b64 edited
  html="$1"
  root="$2"
  max="${READ_DOC_IMAGE_MAX_BYTES:-4194304}"

  map="$(mktemp -t read-doc-img)" || return 0
  # Only <img> is rewritten, and the collection matches the same tags, because a
  # prose document about HTML may well *contain* the text `src="./a.svg"` inside
  # a code block: pandoc escapes `<` there but leaves the quotes alone, so a
  # blind search for the attribute would replace the example with a data URI.
  # Newlines are flattened first because the html5 writer wraps at 72 columns
  # and routinely splits an <img> across two lines.
  #
  # The map is keyed by the src string exactly as it appears in the markup, so
  # the substitution below can stay a literal one.
  tr '\n' ' ' <"${html}" | grep -o '<img[^>]*>' | grep -o 'src="[^"]*"' |
    sed 's/^src="//; s/"$//' | sort -u |
    while IFS= read -r ref; do
      [ -n "${ref}" ] || continue

      # A URL is somebody else's business, and `data:` is already inlined. A
      # colon only introduces a scheme before the first slash: `a:b/c.svg` is a
      # scheme, `dir/a:b.svg` is a filename.
      skip=0
      case "${ref}" in //*) skip=1 ;; esac
      if [ "${skip}" -eq 0 ]; then
        case "${ref}" in
          */*) head="${ref%%/*}" ;;
          *) head="${ref}" ;;
        esac
        case "${head}" in
          [A-Za-z]*:*)
            case "${head%%:*}" in
              *[!A-Za-z0-9+.-]*) ;;
              *) skip=1 ;;
            esac
            ;;
        esac
      fi
      [ "${skip}" -eq 0 ] || continue

      case "${ref}" in
        /*) path="${ref}" ;;
        *) path="${root}/${ref}" ;;
      esac

      # Resolved with `pwd -P` so that `..` and a symlinked directory are both
      # settled before the containment test; comparing the unresolved string
      # would let `images/../../../..` straight through it.
      dir="$(cd "$(dirname -- "${path}")" 2>/dev/null && pwd -P)" || dir=""
      if [ -z "${dir}" ]; then
        printf 'read-doc: image not found: %s\n' "${ref}" >&2
        continue
      fi
      path="${dir}/$(basename -- "${path}")"

      case "${path}" in
        "${root}"/*) ;;
        *)
          printf 'read-doc: refusing to inline %s: outside %s\n' \
            "${ref}" "${root}" >&2
          continue
          ;;
      esac

      if [ ! -f "${path}" ] || [ ! -r "${path}" ]; then
        printf 'read-doc: image not found: %s\n' "${ref}" >&2
        continue
      fi

      if ! mime="$(image_mime "${path}")"; then
        printf 'read-doc: not an inlinable image type: %s\n' "${ref}" >&2
        continue
      fi

      bytes="$(wc -c <"${path}")"
      if [ "${bytes}" -gt "${max}" ]; then
        printf 'read-doc: %s is %s bytes, over the %s-byte inlining cap\n' \
          "${ref}" "${bytes}" "${max}" >&2
        continue
      fi

      b64="$(base64 <"${path}" | tr -d '\n')"
      printf '%s\t%s\n' "${ref}" "data:${mime};base64,${b64}" >>"${map}"
    done

  if [ -s "${map}" ]; then
    edited="$(mktemp -t read-doc-html)" || {
      rm -f "${map}"
      return 0
    }
    # A literal index/substr replacement rather than sub(): a path is not a
    # regex, and the `.` in `a.svg` would otherwise match anything at all.
    #
    # Confined to the inside of an <img> tag, tracked across lines because the
    # writer wraps them. Everything outside one is copied through untouched, so
    # a documented `src="..."` in a code block survives as written.
    if awk -v mapfile="${map}" '
      function subst(seg,   i, p, kept, rest) {
        for (i = 1; i <= n; i++) {
          rest = seg
          kept = ""
          while ((p = index(rest, old[i])) > 0) {
            kept = kept substr(rest, 1, p - 1) new[i]
            rest = substr(rest, p + length(old[i]))
          }
          seg = kept rest
        }
        return seg
      }
      BEGIN {
        while ((getline line < mapfile) > 0) {
          t = index(line, "\t")
          if (t == 0) continue
          n++
          old[n] = "src=\"" substr(line, 1, t - 1) "\""
          new[n] = "src=\"" substr(line, t + 1) "\""
        }
      }
      {
        line = $0
        out = ""
        while (length(line) > 0) {
          if (!intag) {
            p = index(line, "<img")
            if (p == 0) { out = out line; line = ""; continue }
            out = out substr(line, 1, p + 3)
            line = substr(line, p + 4)
            intag = 1
          } else {
            e = index(line, ">")
            if (e == 0) { out = out subst(line); line = ""; continue }
            out = out subst(substr(line, 1, e))
            line = substr(line, e + 1)
            intag = 0
          }
        }
        print out
      }
    ' "${html}" >"${edited}"; then
      mv -- "${edited}" "${html}"
    else
      rm -f "${edited}"
    fi
  fi
  rm -f "${map}"
}

# Only a document read from a local path has neighbours worth resolving.
img_root=""
if [ -z "${fetched}" ] && [ -n "${src}" ] && [ -f "${src}" ]; then
  img_root="$(cd "$(dirname -- "${src}")" && pwd -P)"
fi

if [ "${print_only}" -eq 1 ]; then
  # Through a file rather than straight down the pipe, because inlining the
  # images is a second pass over the finished markup. --print has to carry the
  # same output the browser gets, since that is the form the tests assert on.
  printed="$(mktemp -t read-doc-html)" || exit 2
  if ! feed | render >"${printed}"; then
    rm -f "${printed}"
    exit 2
  fi
  [ -z "${img_root}" ] || embed_images "${printed}" "${img_root}"
  cat -- "${printed}"
  rm -f "${printed}"
  exit 0
fi

out_dir="${TMPDIR:-/tmp}/read-doc"
mkdir -p "${out_dir}" || exit 2

# Keyed on the absolute source path so re-rendering the same document reuses
# one file (and one browser tab) while two same-named files from different
# projects stay apart. A pulled or forwarded document keys on its name instead,
# since its temp path is different on every run.
key="stdin"
if [ -n "${fetched}" ]; then
  key="${base}"
elif [ -n "${src}" ]; then
  key="$(cd "$(dirname -- "${src}")" && pwd)/$(basename -- "${src}")"
fi
slug="$(printf '%s' "${key}" | shasum | cut -c1-8)"
out="${out_dir}/${slug}-${title}.html"

if ! feed | render >"${out}"; then
  printf 'read-doc: render failed\n' >&2
  rm -f "${out}"
  exit 2
fi

[ -z "${img_root}" ] || embed_images "${out}" "${img_root}"

if [ -n "${READ_DOC_BROWSER:-}" ]; then
  open -a "${READ_DOC_BROWSER}" "${out}"
else
  open "${out}"
fi

# On stderr, not stdout: --print writes the document itself to stdout, and
# read-doc is meant to stay usable inside a pipeline. The path is stable for a
# given source (see the key above), so this URL reopens the same page later.
printf 'read-doc: file://%s\n' "${out}" >&2
