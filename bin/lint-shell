#!/usr/bin/env bash
# lint-shell — static-check every shell script in the repo.
#
# Runs shellcheck over the sh/bash scripts and `zsh -n` (parse-only) over the
# zsh ones, which shellcheck cannot read at all (SC1071).
#
# Lives in the repo rather than inline in the CI workflow so the check is
# reproducible locally — in a dotfiles repo you rarely watch CI, and a lint gate
# you can only trigger by pushing gets ignored.
#
# Targets are discovered by shebang, not from a hardcoded path list: a list rots
# silently, and a script that falls out of it stops being checked without anyone
# noticing. Two categories cannot be discovered that way and are named below:
# sourced fragments (no shebang) and the zsh config (the zsh/ modules, and the
# .zshrc/.zshenv entrypoints).
#
# A GATE THAT DISCOVERS ITS OWN TARGETS FAILS BY CHECKING NOTHING AND REPORTING
# OK, which is what happened here once; see bin/lint-shell.md.
#
# Usage:
#   bin/lint-shell           check only (a shfmt diff fails the run)
#   bin/lint-shell --write   apply shfmt's formatting in place
# exit 0 = clean; run from anywhere in the repo.
# LINT_SHELL_JOBS=<n> caps the parallel shellcheck jobs (default: CPU count).
set -uo pipefail

cd "$(dirname "$(readlink -f "$0")")/.." || exit 1

write=false
case "${1:-}" in
  "") ;;
  --write) write=true ;;
  *)
    printf 'lint-shell: unknown argument: %s\n' "$1" >&2
    printf 'Usage: bin/lint-shell [--write]\n' >&2
    exit 1
    ;;
esac

status=0

# The listing is read through a command substitution, not the process
# substitution (`done < <(git ls-files)`) this used to use. A process
# substitution's exit status propagates to neither `set -e` nor `pipefail`, so
# a failed listing left the loops with zero iterations, the targets fell back
# to the sourced fragments named inline below, and the gate printed `ok` having
# skipped every discovered script in the repo. Vacuous green is the one failure
# a lint gate must not have, and nothing reports it.
if ! tracked=$(git ls-files); then
  printf 'lint-shell: git ls-files failed\n' >&2
  exit 1
fi
# git can succeed and still return nothing — a stale index, or a checkout that
# is not one. The inline fallback targets would make that read as a clean run.
if [ -z "$tracked" ]; then
  printf 'lint-shell: git ls-files returned no files; not a checkout?\n' >&2
  exit 1
fi

# One pass sorts every tracked file into the sh and zsh lists. The two tests are
# independent rather than if/elif, so a file is judged for each list on its own.
#
# Whole words, not substrings: `zsh` stays one word when the line is split, so
# it never matches `sh`, and zsh scripts go to the zsh list only.
#
# The zsh entrypoints have no shebang and live outside zsh/, so name them; the
# `zsh/*.zsh` case picks up the modules (including .p10k.zsh — a `case`
# pattern has no dotfile exclusion, unlike pathname expansion).
#
# The first line is read with builtins, not `head -n 1 | grep`: that pipeline
# is three processes per tracked file, ~1.2 s of a ~3 s run on macOS for 327
# files. Its regexes were `^#!.*\b(bash|sh|dash)\b` and `^#!.*\bzsh\b`; the
# same test is "one of these is a whole word of the shebang line", which is
# what splitting the line on non-word characters and matching words gives.
sh_targets=()
zsh_targets=(.zshrc .zshenv)
while IFS= read -r f; do
  [ -f "$f" ] || continue
  # A file without a trailing newline still has its line read; read fails.
  line=''
  IFS= read -r line <"$f" || :
  case "$line" in
    '#!'*) words=" ${line//[^A-Za-z0-9_]/ } " ;;
    *) words='' ;;
  esac
  case "$words" in
    *' bash '* | *' sh '* | *' dash '*) sh_targets+=("$f") ;;
  esac
  case "$f" in
    zsh/*.zsh) zsh_targets+=("$f") ;;
    *) case "$words" in *' zsh '*) zsh_targets+=("$f") ;; esac ;;
  esac
done <<<"$tracked"

# Sourced fragments: never executed directly, so they carry no shebang and the
# discovery above cannot find them. Each declares `# shellcheck shell=bash`
# instead, and must be named here -- a new fragment left out is checked by
# nobody, which lint-shell.test.sh's "every sourced fragment" case catches.
sh_targets+=(bin/init/common.sh bin/init/links.sh bin/pr-review-common.sh bin/tmux-test-guard.sh bin/test-lib.sh)
sh_targets+=(bin/skill-eval-assert.sh bin/skill-eval-scaffold.sh)
sh_targets+=(root/.claude/hooks/segment-scan.lib.sh root/.claude/hooks/git-workdir.lib.sh root/.claude/hooks/git-rules.lib.sh)
sh_targets+=(root/.agents/skills/review-test/evals/lib.sh root/.agents/skills/review-test/evals/grading.sh)
sh_targets+=(root/.agents/skills/review-design/evals/lib.sh root/.agents/skills/review-design/evals/grading.sh)
sh_targets+=(root/.agents/skills/init-project/evals/lib.sh)

# -x follows `. "${SCRIPT_DIR}/common.sh"` into the sourced fragment instead of
# reporting SC1091, so the init scripts are checked against the definitions they
# actually get at runtime. -P SCRIPTDIR is what makes that resolve: the source
# paths are built from runtime variables shellcheck cannot evaluate, so it needs
# to be told to look next to the script being checked.
#
# Most of the run is shellcheck (~6.5s of ~8s for ~100 files, one core), and it
# checks each file on its own, so the targets are split into contiguous chunks
# run as parallel jobs. Each job's output is held in a file and replayed in
# chunk order, so the report reads exactly as a single run's would instead of
# interleaving. Every job's status is collected by its own `wait`: a bare
# `wait` returns 0 regardless, and would swallow a finding.
#
# An empty LINT_SHELL_JOBS means the default, as an unset one does. Each
# rejected shape below breaks the chunk arithmetic in its own way:
#   ''         getconf printed nothing, so there is no count at all
#   *[!0-9]*   a negative count never ends the chunk loop; text is no count
#   0*         0 divides by zero, and bash reads a leading zero as octal --
#              010 would silently mean 8 and 08 would be an error
jobs=${LINT_SHELL_JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)}
case "$jobs" in
  '' | *[!0-9]* | 0*)
    printf 'lint-shell: LINT_SHELL_JOBS must be a positive integer: %s\n' "$jobs" >&2
    exit 1
    ;;
esac
n=${#sh_targets[@]}
# Ceiling division, so no chunk is empty: shellcheck handed no files fails.
per=$(((n + jobs - 1) / jobs))

if ! outdir=$(mktemp -d); then
  printf 'lint-shell: mktemp failed\n' >&2
  exit 1
fi
trap 'rm -rf "$outdir"' EXIT

printf -- '--- shellcheck (%d files) ---\n' "$n"
pids=()
i=0
while [ "$i" -lt "$n" ]; do
  shellcheck -x -P SCRIPTDIR "${sh_targets[@]:i:per}" >"$outdir/$i.out" 2>"$outdir/$i.err" &
  pids+=("$!")
  i=$((i + per))
done
sc_status=0
i=0
for pid in "${pids[@]}"; do
  wait "$pid" || sc_status=1
  cat "$outdir/$i.out"
  cat "$outdir/$i.err" >&2
  i=$((i + per))
done
if [ "$sc_status" -eq 0 ]; then
  printf 'ok\n'
else
  status=1
fi

# shfmt is fed the shellcheck target list rather than its own `shfmt -f`
# listing. `shfmt -f` claims *.zsh by extension — 21 files here — and shfmt
# parses as bash, so it would rewrite zsh modules through a parser that cannot
# represent them. The shebang discovery above already excludes zsh correctly.
#
# -i 2 matches the majority of scripts here; -ci keeps `case` branches indented,
# which is this repo's existing style — without it shfmt de-indents every one of
# them and the adoption diff nearly doubles for no reading benefit.

if [ "$write" = true ]; then
  printf -- '\n--- shfmt -w (%d files) ---\n' "${#sh_targets[@]}"
  shfmt_args=(-w -i 2 -ci)
else
  printf -- '\n--- shfmt -d (%d files) ---\n' "${#sh_targets[@]}"
  shfmt_args=(-d -i 2 -ci)
fi
if shfmt "${shfmt_args[@]}" "${sh_targets[@]}"; then
  printf 'ok\n'
else
  status=1
fi

printf -- '\n--- zsh -n (%d files) ---\n' "${#zsh_targets[@]}"
zsh_status=0
for f in "${zsh_targets[@]}"; do
  if ! zsh -n "$f"; then
    printf 'FAIL %s\n' "$f"
    zsh_status=1
  fi
done
if [ "$zsh_status" -eq 0 ]; then
  printf 'ok\n'
else
  status=1
fi

exit "$status"
