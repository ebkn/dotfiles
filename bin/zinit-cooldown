#!/usr/bin/env zsh
# zinit-cooldown [--days N] [plugin.zsh] — move each commit pin in
# zsh/plugin.zsh forward to the newest release tag whose commit was already on
# the repository's default branch N days ago (default 7), as GitHub's push
# record has it. Prints one line per repository; rewrites only the pins that
# move, and commits nothing. See bin/zinit-cooldown.md.
#
# Exit: 0 when every repository was decided (moved, up to date, or held), 1
# when any could not be (API failure, a SHA that does not appear exactly
# once, a write that fails, pins that cannot be read), 2 on a usage error.

emulate -L zsh
setopt extendedglob pipefail
zmodload zsh/datetime

usage() { print -u2 -- "usage: zinit-cooldown [--days N] [plugin.zsh]"; exit 2; }

days=7
while (( $# )); do
  case $1 in
    --days) [[ ${2-} == <-> ]] || usage; days=$2; shift 2 ;;
    -*) usage ;;
    *) break ;;
  esac
done
(( $# <= 1 )) || usage
file=${1:-${0:A:h}/../zsh/plugin.zsh}

# The pins, or nothing: a pin the reader could not see would be left behind
# without a word. See bin/zinit-pins.md.
pins=$(${0:A:h}/zinit-pins $file) || exit 1

# GitHub's timestamps are UTC ISO 8601, which order as strings.
cutoff=$(TZ=UTC strftime '%Y-%m-%dT%H:%M:%SZ' $(( EPOCHSECONDS - days * 86400 )))

api() { command gh api "$@"; }

# status <repo> <base> <head> — GitHub's compare status of head against base:
# ahead, behind, identical or diverged.
status() { api "repos/$1/compare/$2...$3" | jq -er .status; }

# candidates <repo> — release tags newest first; without releases, every tag
# by version, highest first (0.10 after 0.9).
# Tags stand in for releases only in a repository that has none at all: one
# that publishes releases has said which tags are versions, and a draft or a
# pre-release is not one -- so with none published, there is nothing to take.
# A failed call fails the repo for the same reason: falling back to tags
# because releases could not be read would change which commits count without
# anyone deciding it. An empty list is not a failure (`jq -r`, not `-e`, which
# treats no output as one).
# Status: 0 with the candidates (possibly none), 1 releases unreadable,
# 2 tags unreadable, 3 releases exist but none is published.
candidates() {
  local json rel names
  json=$(api "repos/$1/releases?per_page=20") || return 1
  rel=$(jq -r '.[] | select(.draft | not) | select(.prerelease | not) | .tag_name' <<<$json) || return 1
  if [[ -n $rel ]]; then
    print -r -- $rel
    return 0
  fi
  [[ $(jq -r length <<<$json) == 0 ]] || return 3
  names=$(api "repos/$1/tags?per_page=100" | jq -r '.[].name') || return 2
  print -rl -- ${(On)${(f)names}}
}

typeset -i failed=0
for line in ${(f)pins}; do
  repo=${line% *} pin=${line#* }
  report() { print -r -- "$repo: $*"; }
  {
    branch=$(api "repos/$repo" | jq -er .default_branch) || { report "error: cannot read the repository"; failed=1; continue; }

    # The branch's tip at the cutoff: the newest recorded push at or before it.
    # A commit is old enough when that tip contains it.
    # One call, kept: asking again to tell "unreadable" from "empty" could get
    # a different answer the second time.
    activity=$(api "repos/$repo/activity?ref=refs/heads/$branch&per_page=100") ||
      { report "error: cannot read the push history"; failed=1; continue; }
    tip=$(jq -r --arg c "$cutoff" '[.[] | select(.timestamp <= $c)][0].after // empty' <<<$activity) ||
      { report "error: cannot read the push history"; failed=1; continue; }
    if [[ -z $tip ]]; then
      report "stays: no push to $branch older than $days days on record"
      continue
    fi

    tagged=$(candidates $repo)
    case $? in
      1) report "error: cannot list the releases"; failed=1; continue ;;
      2) report "error: cannot list the tags"; failed=1; continue ;;
      3) report "stays: no published release"; continue ;;
    esac
    if [[ -z $tagged ]]; then
      report "stays: no tags"
      continue
    fi

    eligible='' esha=''
    for tag in ${(f)tagged}; do
      sha=$(api "repos/$repo/commits/$tag" | jq -er .sha) || { report "error: cannot resolve $tag"; failed=1; continue 2; }
      st=$(status $repo $sha $tip) || { report "error: cannot compare $tag"; failed=1; continue 2; }
      if [[ $st == (ahead|identical) ]]; then
        eligible=$tag esha=$sha
        break
      fi
    done
    if [[ -z $eligible ]]; then
      report "stays: no release tag was on $branch $days days ago"
      continue
    fi

    if [[ $esha == $pin ]]; then
      report "up to date ($eligible)"
      continue
    fi
    st=$(status $repo $pin $esha) || { report "error: cannot compare the pin with $eligible"; failed=1; continue; }
    if [[ $st != ahead ]]; then
      # Forward only: moving back is a decision for a person, not this tool.
      report "stays: $eligible ($esha) is $st the pin, which only moves forward"
      continue
    fi

    # The rewrite is a plain substitution, so the SHA must appear exactly once.
    # `read -d ''` keeps the file byte for byte, trailing newlines included,
    # which $(<file) would strip; the new file replaces the old with mv, so a
    # failure part-way leaves the old one whole.
    IFS= read -rd '' content < $file
    # Occurrences, not lines: a comment quoting the SHA on the pin's own line
    # would leave the old one behind.
    count=$(( ${#${(ps:$pin:)${:-x${content}x}}} - 1 ))
    if (( count != 1 )); then
      report "error: $pin appears $count times in ${file:t}, not once"
      failed=1
      continue
    fi
    if ! { print -rn -- "${content/$pin/$esha}" > $file.cooldown && command mv -f $file.cooldown $file; }; then
      command rm -f $file.cooldown
      report "error: cannot write ${file:t}"
      failed=1
      continue
    fi
    report "moved ${pin[1,7]}..${esha[1,7]} ($eligible) https://github.com/$repo/compare/$pin...$esha"
  } always {
    unfunction report
  }
done

exit $failed
