#!/usr/bin/env bash
# fzf-files: list git-changed files first, then all remaining files (deduped).
# Extra arguments are passed through to rg (e.g. --glob "!dir/**").
# Falls back to plain rg --files outside a git repo.
#
# --label: prepend tab-delimited [ label ] to git-changed files.
#   With fzf --tabstop=1, the tab renders as a single space:
#     [ untracked   ] path
#     [ staged      ] path
#     [ unstaged    ] path
#     [ hash(-N)    ] path   ← N = how many commits ago (1–5)
#     path                ← no label, no leading space
#   Priority: untracked > staged > unstaged > committed (first label wins per file).

set -euo pipefail

label_mode=false
if [[ "${1-}" == "--label" ]]; then
  label_mode=true
  shift
fi

rg_base=(rg --files --hidden --smart-case --glob='!.git/*')

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  # Change detection uses `git status --porcelain`, NOT `git diff`. In a repo whose
  # Git LFS objects are checked out as real files in the working tree, `git diff`
  # runs the LFS clean filter over modified tracked files to compare contents —
  # re-reading multi-GB blobs and taking seconds to tens of seconds. That freeze
  # is invisible here because fzf-files feeds fzf through a command substitution:
  # no candidate appears until the git call returns, so the whole picker hangs.
  # `git status` reports the same untracked/staged/unstaged set via stat, staying
  # in the tens-of-ms range, so it needs neither the LFS clean-filter read nor the
  # fragile `git lfs ls-files` pathspec exclusion this script used to carry (that
  # exclusion silently no-op'd whenever git-lfs was off the caller's PATH — e.g. a
  # subprocess spawned by the editor — reintroducing the freeze).
  #
  # status prints repo-root-relative paths and has no --relative; strip the current
  # subdir prefix (and drop anything outside it) so the output lines up with
  # `rg --files`, which is cwd-relative. `git log --relative` is LFS-safe (it diffs
  # committed trees, never the working copy) so it keeps --relative directly.
  prefix=$(git rev-parse --show-prefix)

  if "$label_mode"; then
    # Build labeled list: [ label    ]\tpath
    # Use HASH: prefix marker to distinguish commit hashes from filenames.
    changed=$(
      {
        git status --porcelain -uall -- . 2>/dev/null | awk -v pfx="$prefix" '
          {
            xy = substr($0, 1, 2)
            path = substr($0, 4)
            i = index(path, " -> "); if (i > 0) path = substr(path, i + 4)  # rename: keep new name
            if (pfx != "") { if (index(path, pfx) != 1) next; path = substr(path, length(pfx) + 1) }
            # Bucket by category, emit in priority order (untracked > staged > unstaged)
            # in END so display order does not depend on git status sort order.
            if (xy == "??")                   { u[++nu] = path }
            else if (substr(xy, 1, 1) != " ") { s[++ns] = path }
            else                              { g[++ng] = path }
          }
          END {
            for (k = 1; k <= nu; k++) printf "[ untracked   ]\t%s\n", u[k]
            for (k = 1; k <= ns; k++) printf "[ staged      ]\t%s\n", s[k]
            for (k = 1; k <= ng; k++) printf "[ unstaged    ]\t%s\n", g[k]
          }'
        git log --relative --name-only --pretty='format:HASH:%h' -5 -- . \
          | awk '/^HASH:/{n++; hash=$0; sub(/^HASH:/,"",hash); next} NF{printf "[ %-11s ]\t%s\n", hash"(-"n")", $0}'
      }
    )

    # Output changed files (existing only, first label wins per path), then rg files
    {
      while IFS=$'\t' read -r lbl f; do
        [[ -f "$f" ]] && printf '%s\t%s\n' "$lbl" "$f"
      done <<< "$changed"
      "${rg_base[@]}" "$@"
    } | awk -F'\t' '!seen[$NF]++'
  else
    # Plain mode: no labels
    changed=$(
      {
        git status --porcelain -uall -- . 2>/dev/null | awk -v pfx="$prefix" '
          {
            path = substr($0, 4)
            i = index(path, " -> "); if (i > 0) path = substr(path, i + 4)
            if (pfx != "") { if (index(path, pfx) != 1) next; path = substr(path, length(pfx) + 1) }
            print path
          }'
        git log --relative --name-only --pretty=format: -5 -- .
      } | awk 'NF && !seen[$0]++'
    )

    {
      while IFS= read -r f; do
        [[ -f "$f" ]] && printf '%s\n' "$f"
      done <<< "$changed"
      "${rg_base[@]}" "$@"
    } | awk '!seen[$0]++'
  fi
else
  "${rg_base[@]}" "$@"
fi
